function grade(int score) : char*
    t1 = score >= 90                     ; int
    ifFalse t1 goto L1
    return str0                          ; char*
    goto L2
L1:
    t2 = score >= 80                     ; int
    ifFalse t2 goto L3
    return str1                          ; char*
    goto L4
L3:
    t3 = score >= 70                     ; int
    ifFalse t3 goto L5
    return str2                          ; char*
    goto L6
L5:
    t4 = score >= 60                     ; int
    ifFalse t4 goto L7
    return str3                          ; char*
    goto L8
L7:
    return str4                          ; char*
L8:
L6:
L4:
L2:
    return
endfunction

function classify(int x) : int
    t1 = x > 0                           ; int
    ifFalse t1 goto L9
    t2 = x % 2                           ; int
    t3 = t2 == 0                         ; int
    ifFalse t3 goto L10
    return 2                             ; int
    goto L11
L10:
    return 1                             ; int
L11:
    goto L12
L9:
    t4 = x < 0                           ; int
    ifFalse t4 goto L13
    return -1                            ; int
L13:
L12:
    return 0                             ; int
endfunction

