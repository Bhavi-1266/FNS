function calc(enum Op op, int a, int b) : int
    t1 = (int) op                        ; int
    t2 = t1 == 1                         ; int
    if t2 goto L2
    t3 = t1 == 2                         ; int
    if t3 goto L3
    t4 = t1 == 10                        ; int
    if t4 goto L4
    t5 = t1 == 11                        ; int
    if t5 goto L5
    goto L1
L2:
    t6 = a + b                           ; int
    return t6                            ; int
L3:
    t7 = a - b                           ; int
    return t7                            ; int
L4:
    t8 = a * b                           ; int
    return t8                            ; int
L5:
    ifFalse b goto L6
    t10 = a / b                          ; int
    t9 = t10                             ; int
    goto L7
L6:
    t9 = 0                               ; int
L7:
    return t9                            ; int
L1:
    return -999                          ; int
endfunction

function kind(char c) : char*
    t1 = (int) c                         ; int
    t2 = t1 == 97                        ; int
    if t2 goto L9
    t3 = t1 == 101                       ; int
    if t3 goto L10
    t4 = t1 == 105                       ; int
    if t4 goto L11
    t5 = t1 == 111                       ; int
    if t5 goto L12
    t6 = t1 == 117                       ; int
    if t6 goto L13
    t7 = t1 == 32                        ; int
    if t7 goto L14
    goto L15
L9:
L10:
L11:
L12:
L13:
    return str0                          ; char*
L14:
    return str1                          ; char*
L15:
    t9 = (int) c                         ; int
    t10 = (int) 48                       ; int
    t11 = t9 >= t10                      ; int
    ifFalse t11 goto L17
    t12 = (int) c                        ; int
    t13 = (int) 57                       ; int
    t14 = t12 <= t13                     ; int
    ifFalse t14 goto L17
    t8 = 1                               ; int
    goto L18
L17:
    t8 = 0                               ; int
L18:
    ifFalse t8 goto L16
    return str2                          ; char*
L16:
    return str3                          ; char*
L8:
    return
endfunction

