    t2 = i * 4                           ; int
    t3 = a + t2                          ; int*
    t4 = *t3                             ; int
    t5 = s + t4                          ; int
    s = t5                               ; int
L2:
    t6 = i + 1                           ; int
    i = t6                               ; int
    goto L1
L3:
    return s                             ; int
endfunction

