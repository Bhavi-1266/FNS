.text

function swap(int* x, int* y) : void
    local t : int (4)
    t1 = *x                              ; int
    t = t1                               ; int
    t2 = *y                              ; int
    *x = t2                              ; int
    *y = t                               ; int
    return
endfunction

function set_ptr(int** pp, int* target) : void
    *pp = target                         ; int*
    return
endfunction

function find_max(int* a, int n) : int*
    local best : int* (4)
    local p : int* (4)
    best = a                             ; int*
    p = a                                ; int*
L1:
    t1 = n * 4                           ; int
    t2 = a + t1                          ; int*
    t3 = p < t2                          ; int
    ifFalse t3 goto L3
    t4 = *p                              ; int
    t5 = *best                           ; int
    t6 = t4 > t5                         ; int
    ifFalse t6 goto L4
    best = p                             ; int*
L4:
L2:
    t7 = p + 4                           ; int*
    p = t7                               ; int*
    goto L1
L3:
    return best                          ; int*
endfunction

