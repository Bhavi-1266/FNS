    printf
    strcpy

.text

function add(struct anon_2& a, struct anon_2& b) : struct anon_2
    local r : struct anon_2 (16)
    t1 = &r                              ; struct anon_2*
    t2 = *a                              ; double
    t3 = *b                              ; double
    t4 = t2 + t3                         ; double
    *t1 = t4                             ; double
    t5 = &r                              ; struct anon_2*
    t6 = t5 + 8                          ; double*
    t7 = a + 8                           ; double*
    t8 = *t7                             ; double
    t9 = b + 8                           ; double*
    t10 = *t9                            ; double
    t11 = t8 + t10                       ; double
    *t6 = t11                            ; double
    t12 = &r                             ; struct anon_2*
    return t12                           ; struct anon_2
endfunction

function birthday(struct Student* s) : void
    t1 = s + 24                          ; struct Date*
    t2 = t1 + 8                          ; int*
    t3 = *t2                             ; int
    t4 = t3 - 1                          ; int
    *t2 = t4                             ; int
    t5 = s + 20                          ; float*
    t6 = *t5                             ; float
    t7 = t6 + 1.5f                       ; float
    *t5 = t7                             ; float
    return
endfunction

function try_modify(struct Student& s) : void
    t1 = s + 16                          ; int*
    *t1 = -1                             ; int
    return
endfunction

function top(struct Student* list, int n) : struct Student
    local best : int (4)
    local i : int (4)
    best = 0                             ; int
    i = 1                                ; int
L1:
    t1 = i < n                           ; int
    ifFalse t1 goto L3
    t2 = i * 36                          ; int
    t3 = list + t2                       ; struct Student*
    t4 = t3 + 20                         ; float*
    t5 = *t4                             ; float
    t6 = best * 36                       ; int
    t7 = list + t6                       ; struct Student*
    t8 = t7 + 20                         ; float*
    t9 = *t8                             ; float
    t10 = t5 > t9                        ; int
    ifFalse t10 goto L4
    best = i                             ; int
L4:
L2:
    t11 = i + 1                          ; int
    i = t11                              ; int
    goto L1
L3:
    t12 = best * 36                      ; int
    t13 = list + t12                     ; struct Student*
    return t13                           ; struct Student
endfunction

