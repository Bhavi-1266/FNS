; source: test/07_structs.c

.data
    str0: "Asha"
    str1: "Bilal"
    str2: "Chen"
    str3: "%-6s %2d %6.2f %02d/%02d/%d\n"
    str4: "top: %s\n"
    str5: "roll still %d\n"
    str6: "%s now born %d, marks %.2f\n"
    str7: "Copy"
    str8: "%s %d / %s %d\n"
    str9: "(%.1f, %.1f)\n"
    str10: "%d -> "
    str11: "NULL\n"
    str12: "sizeof(struct Date)=%d sizeof(Complex)=%d\n"
    str13: "via pointer: %d-%d-%d\n"
    str14: "%d/%d/%d %d %d %d %.1f %.1f\n"
    str15: "bits: %u %u %d %u size=%d\n"

