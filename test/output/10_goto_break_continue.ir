; FNS three-address code
; source: test/10_goto_break_continue.c

.data
    str0: "%d "
    str1: "\n"
    str2: "not printed\n"
    str3: "skipped ahead\n"
    str4: "found=%d at r=%d c=%d\n"
    str5: "w%d "
    str6: "d%d "
    str7: "(%d,%d)"
    str8: "s%d "
    str9: "after%d "
    str10: "n=%d "

.extern
    printf

.text

function main() : int
    local i : int (4)
    local x : int (4)
    local r : int (4)
    local c : int (4)
    local found : int (4)
    local a : int (4)
    local b : int (4)
    local n : int (4)
    i = 0                                ; int
again:
    param str0
    param i
    t1 = call printf, 2                  ; int
    t2 = i + 1                           ; int
    i = t2                               ; int
    t3 = i < 5                           ; int
    ifFalse t3 goto L1
    goto again
L1:
    param str1
    t4 = call printf, 1                  ; int
    x = 1                                ; int
    ifFalse x goto L2
    goto skip
L2:
    param str2
    t5 = call printf, 1                  ; int
skip:
    param str3
    t6 = call printf, 1                  ; int
    found = 0                            ; int
    r = 0                                ; int
L3:
    t7 = r < 5                           ; int
    ifFalse t7 goto L5
    c = 0                                ; int
L6:
    t8 = c < 5                           ; int
    ifFalse t8 goto L8
    t9 = r * c                           ; int
    t10 = t9 == 6                        ; int
    ifFalse t10 goto L9
    found = 1                            ; int
    goto done
L9:
L7:
    t11 = c + 1                          ; int
    c = t11                              ; int
    goto L6
L8:
L4:
    t12 = r + 1                          ; int
    r = t12                              ; int
    goto L3
L5:
done:
    param str4
    param found
    param r
    param c
    t13 = call printf, 4                 ; int
    i = 0                                ; int
L10:
    t14 = i < 10                         ; int
    ifFalse t14 goto L12
    t15 = i % 3                          ; int
    t16 = t15 == 0                       ; int
    ifFalse t16 goto L13
    goto L11
L13:
    t17 = i > 7                          ; int
    ifFalse t17 goto L14
    goto L12
L14:
    param str0
    param i
    t18 = call printf, 2                 ; int
L11:
    t19 = i + 1                          ; int
    i = t19                              ; int
    goto L10
L12:
    param str1
    t20 = call printf, 1                 ; int
    i = 0                                ; int
L15:
    ifFalse 1 goto L16
    t21 = i + 1                          ; int
    i = t21                              ; int
    t22 = i % 2                          ; int
    ifFalse t22 goto L17
    goto L15
L17:
    t23 = i > 8                          ; int
    ifFalse t23 goto L18
    goto L16
L18:
    param str5
    param i
    t24 = call printf, 2                 ; int
    goto L15
L16:
    param str1
    t25 = call printf, 1                 ; int
    i = 0                                ; int
L19:
    t26 = i + 1                          ; int
    i = t26                              ; int
    t27 = i == 2                         ; int
    ifFalse t27 goto L22
    goto L20
L22:
    param str6
    param i
    t28 = call printf, 2                 ; int
L20:
    t29 = i < 4                          ; int
    if t29 goto L19
L21:
    param str1
    t30 = call printf, 1                 ; int
    a = 0                                ; int
L23:
    t31 = a < 3                          ; int
    ifFalse t31 goto L25
    b = 0                                ; int
L26:
    t32 = b < 3                          ; int
    ifFalse t32 goto L28
    t33 = b == 1                         ; int
    ifFalse t33 goto L29
    goto L28
L29:
    param str7
    param a
    param b
    t34 = call printf, 3                 ; int
L27:
    t35 = b + 1                          ; int
    b = t35                              ; int
    goto L26
L28:
L24:
    t36 = a + 1                          ; int
    a = t36                              ; int
    goto L23
L25:
    param str1
    t37 = call printf, 1                 ; int
    i = 0                                ; int
L30:
    t38 = i < 4                          ; int
    ifFalse t38 goto L32
    t39 = i == 1                         ; int
    if t39 goto L34
    t40 = i == 2                         ; int
    if t40 goto L35
    goto L36
L34:
    goto L31
L35:
    goto L33
L36:
    param str8
    param i
    t41 = call printf, 2                 ; int
L33:
    param str9
    param i
    t42 = call printf, 2                 ; int
L31:
    t43 = i + 1                          ; int
    i = t43                              ; int
    goto L30
L32:
    param str1
    t44 = call printf, 1                 ; int
    n = 3                                ; int
L37:
    t45 = n > 0                          ; int
    ifFalse t45 goto L38
    t46 = n - 1                          ; int
    n = t46                              ; int
    t47 = n == 1                         ; int
    ifFalse t47 goto L39
    goto next
L39:
    param str10
    param n
    t48 = call printf, 2                 ; int
next:
    goto L37
L38:
    param str1
    t49 = call printf, 1                 ; int
    return 0                             ; int
endfunction
