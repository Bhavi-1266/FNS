; FNS three-address code
; source: test/11_static.c

.data
    str0: "counter=%d "
    str1: "\n"
    str2: "%d %d %d\n"
    str3: "max depth=%d\n"
    str4: "ids: %d %d %d %d\n"
    str5: "%s "
    str6: "%s\n"
    str7: "calls=%d helper=%d\n"
    str8: "ratio=%.2f\n"
    global calls : int (4) = 0
    global counter_n : int (4) = 0
    global other_counter_n : int (4) = 100
    global depth_tracker_max_depth : int (4) = 0
    global next_id_ids : int[3] (12) = {7, 8, 9}
    global next_id_pos : int (4)
    global name_of_buf : char[8] (8)
    global main_ratio : double (8) = 0.5

.extern
    printf

.text

function helper(int x) : int
    t1 = x * 2                           ; int
    return t1                            ; int
endfunction

function counter() : int
    t1 = counter_n + 1                   ; int
    counter_n = t1                       ; int
    t2 = calls + 1                       ; int
    calls = t2                           ; int
    return counter_n                     ; int
endfunction

function other_counter() : int
    t1 = other_counter_n                 ; int
    t2 = other_counter_n - 1             ; int
    other_counter_n = t2                 ; int
    return t1                            ; int
endfunction

function depth_tracker(int level) : int
    t1 = level > depth_tracker_max_depth ; int
    ifFalse t1 goto L1
    depth_tracker_max_depth = level      ; int
L1:
    t2 = level < 4                       ; int
    ifFalse t2 goto L2
    t3 = level + 1                       ; int
    param t3
    t4 = call depth_tracker, 1           ; int
L2:
    return depth_tracker_max_depth       ; int
endfunction

function next_id() : int
    local v : int (4)
    t1 = &next_id_ids                    ; int*
    t2 = next_id_pos % 3                 ; int
    t3 = t2 * 4                          ; int
    t4 = t1 + t3                         ; int*
    t5 = *t4                             ; int
    v = t5                               ; int
    t6 = next_id_pos + 1                 ; int
    next_id_pos = t6                     ; int
    return v                             ; int
endfunction

function name_of(int k) : char*
    t1 = &name_of_buf                    ; char*
    *t1 = 110                            ; char
    t2 = &name_of_buf                    ; char*
    t3 = t2 + 1                          ; char*
    t4 = (int) 48                        ; int
    t5 = t4 + k                          ; int
    t6 = (char) t5                       ; char
    *t3 = t6                             ; char
    t7 = &name_of_buf                    ; char*
    t8 = t7 + 2                          ; char*
    *t8 = 0                              ; char
    t9 = &name_of_buf                    ; char*
    t10 = (char*) t9                     ; char*
    return t10                           ; char*
endfunction

function main() : int
    local i : int (4)
    local o1 : int (4)
    local o2 : int (4)
    local o3 : int (4)
    local i1 : int (4)
    local i2 : int (4)
    local i3 : int (4)
    local i4 : int (4)
    i = 0                                ; int
L3:
    t1 = i < 3                           ; int
    ifFalse t1 goto L5
    t2 = call counter, 0                 ; int
    param str0
    param t2
    t3 = call printf, 2                  ; int
L4:
    t4 = i + 1                           ; int
    i = t4                               ; int
    goto L3
L5:
    param str1
    t5 = call printf, 1                  ; int
    t6 = call other_counter, 0           ; int
    o1 = t6                              ; int
    t7 = call other_counter, 0           ; int
    o2 = t7                              ; int
    t8 = call other_counter, 0           ; int
    o3 = t8                              ; int
    param str2
    param o1
    param o2
    param o3
    t9 = call printf, 4                  ; int
    param 0
    t10 = call depth_tracker, 1          ; int
    param str3
    param t10
    t11 = call printf, 2                 ; int
    t12 = call next_id, 0                ; int
    i1 = t12                             ; int
    t13 = call next_id, 0                ; int
    i2 = t13                             ; int
    t14 = call next_id, 0                ; int
    i3 = t14                             ; int
    t15 = call next_id, 0                ; int
    i4 = t15                             ; int
    param str4
    param i1
    param i2
    param i3
    param i4
    t16 = call printf, 5                 ; int
    param 3
    t17 = call name_of, 1                ; char*
    param str5
    param t17
    t18 = call printf, 2                 ; int
    param 5
    t19 = call name_of, 1                ; char*
    param str6
    param t19
    t20 = call printf, 2                 ; int
    param 21
    t21 = call helper, 1                 ; int
    param str7
    param calls
    param t21
    t22 = call printf, 3                 ; int
    t23 = (double) 3                     ; double
    t24 = main_ratio * t23               ; double
    main_ratio = t24                     ; double
    param str8
    param main_ratio
    t25 = call printf, 2                 ; int
    return 0                             ; int
endfunction
