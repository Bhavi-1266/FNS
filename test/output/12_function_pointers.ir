; FNS three-address code
; source: test/12_function_pointers.c

.data
    str0: "<%d>"
    str1: "%d %d\n"
    str2: "%d\n"
    str3: "add"
    str4: "sub"
    str5: "mul"
    str6: "max"
    str7: "%s(7,3)=%d "
    str8: "\n"
    str9: "sum=%d product=%d max=%d\n"
    str10: "%d "
    str11: "%.2f\n"
    str12: "%d %d %d\n"
    str13: "none is %s\n"
