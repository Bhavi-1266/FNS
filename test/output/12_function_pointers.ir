.extern
    printf
    qsort

.text

function add(int a, int b) : int
    t1 = a + b                           ; int
    return t1                            ; int
endfunction

function sub(int a, int b) : int
    t1 = a - b                           ; int
    return t1                            ; int
endfunction

function mul(int a, int b) : int
    t1 = a * b                           ; int
    return t1                            ; int
endfunction

function maxi(int a, int b) : int
    t2 = a > b                           ; int
    ifFalse t2 goto L1
    t1 = a                               ; int
    goto L2
L1:
    t1 = b                               ; int
L2:
    return t1                            ; int
endfunction

function fold(int* a, int n, fn* f, int init) : int
    local acc : int (4)
    local i : int (4)
    acc = init                           ; int
    i = 0                                ; int
L3:
    t1 = i < n                           ; int
    ifFalse t1 goto L5
    t2 = i * 4                           ; int
    t3 = a + t2                          ; int*
    t4 = *t3                             ; int
    param acc
    param t4
    t5 = call *f, 2                      ; int
    acc = t5                             ; int
L4:
    t6 = i + 1                           ; int
    i = t6                               ; int
    goto L3
L5:
    return acc                           ; int
endfunction

function for_each(int* a, int n, fn* visit) : void
    local i : int (4)
    i = 0                                ; int
L6:
    t1 = i < n                           ; int
    ifFalse t1 goto L8
    t2 = i * 4                           ; int
    t3 = a + t2                          ; int*
    t4 = *t3                             ; int
    param t4
    call *visit, 1
L7:
    t5 = i + 1                           ; int
    i = t5                               ; int
    goto L6
L8:
    return
endfunction

function show(int x) : void
    param str0
    param x
    t1 = call printf, 2                  ; int
    return
endfunction

function show_square(int x) : void
    t1 = x * x                           ; int
    param str0
    param t1
    t2 = call printf, 2                  ; int
    return
endfunction

function cmp_asc(void* p, void* q) : int
    t1 = (int*) p                        ; int*
    t2 = *t1                             ; int
    t3 = (int*) q                        ; int*
    t4 = *t3                             ; int
    t5 = t2 - t4                         ; int
    return t5                            ; int
endfunction

function cmp_desc(void* p, void* q) : int
    t1 = (int*) q                        ; int*
    t2 = *t1                             ; int
    t3 = (int*) p                        ; int*
    t4 = *t3                             ; int
    t5 = t2 - t4                         ; int
    return t5                            ; int
endfunction

function apply_d(fn* g, double v) : double
    param v
    t1 = call *g, 1                      ; double
    return t1                            ; double
endfunction

function half(double v) : double
    t1 = (double) 2                      ; double
    t2 = v / t1                          ; double
    return t2                            ; double
endfunction

function choose_raw(char op) : fn*
    t2 = (int) op                        ; int
    t3 = (int) 43                        ; int
    t4 = t2 == t3                        ; int
    ifFalse t4 goto L9
    t1 = add                             ; fn*
    goto L10
L9:
    t1 = sub                             ; fn*
L10:
    return t1                            ; fn*
endfunction

function twice(fn** pp, int x) : int
    t1 = *pp                             ; fn*
    t2 = *pp                             ; fn*
    param x
    param x
    t3 = call *t2, 2                     ; int
    param t3
    param x
    t4 = call *t1, 2                     ; int
    return t4                            ; int
endfunction

function choose(char op) : fn*
    t1 = (int) op                        ; int
    t2 = t1 == 43                        ; int
    if t2 goto L12
    t3 = t1 == 45                        ; int
    if t3 goto L13
    goto L14
L12:
    return add                           ; fn*
L13:
    return sub                           ; fn*
L14:
    return mul                           ; fn*
L11:
    return
endfunction

