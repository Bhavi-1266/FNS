    param str0
    param t13
    t14 = call printf, 2                 ; int
L13:
    t15 = i + 1                          ; int
    i = t15                              ; int
    goto L12
L14:
    t16 = (char*) 0                      ; char*
    ap = t16                             ; char*
    param str1
    t17 = call printf, 1                 ; int
    return
endfunction

