function sum(int count, ...) : int
    local ap : char* (4)
    local total : int (4)
    local i : int (4)
    t1 = &__va_args                      ; char*
    ap = t1                              ; char*
    total = 0                            ; int
    i = 0                                ; int
L1:
    t2 = i < count                       ; int
    ifFalse t2 goto L3
    t3 = 4 + 3                           ; int
    t4 = t3 / 4                          ; int
    t5 = t4 * 4                          ; int
    t6 = ap + t5                         ; char*
    ap = t6                              ; char*
    t7 = 4 + 3                           ; int
    t8 = t7 / 4                          ; int
    t9 = t8 * 4                          ; int
    t10 = t6 - t9                        ; char*
    t11 = (int*) t10                     ; int*
    t12 = *t11                           ; int
    t13 = total + t12                    ; int
    total = t13                          ; int
L2:
    t14 = i + 1                          ; int
    i = t14                              ; int
    goto L1
L3:
    t15 = (char*) 0                      ; char*
    ap = t15                             ; char*
    return total                         ; int
endfunction

