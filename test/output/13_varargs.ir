L4:
    t3 = i < count                       ; int
    ifFalse t3 goto L6
    t4 = 8 + 3                           ; int
    t5 = t4 / 4                          ; int
    t6 = t5 * 4                          ; int
    t7 = ap + t6                         ; char*
    ap = t7                              ; char*
    t8 = 8 + 3                           ; int
    t9 = t8 / 4                          ; int
    t10 = t9 * 4                         ; int
    t11 = t7 - t10                       ; char*
    t12 = (double*) t11                  ; double*
    t13 = *t12                           ; double
    t14 = total + t13                    ; double
    total = t14                          ; double
L5:
    t15 = i + 1                          ; int
    i = t15                              ; int
    goto L4
L6:
    t16 = (char*) 0                      ; char*
    ap = t16                             ; char*
    ifFalse count goto L7
    t18 = (double) count                 ; double
    t19 = total / t18                    ; double
    t17 = t19                            ; double
    goto L8
L7:
    t20 = (double) 0                     ; double
    t17 = t20                            ; double
L8:
    return t17                           ; double
endfunction

function max_of(int first, ...) : int
    local ap : char* (4)
    local best : int (4)
    local v : int (4)
    best = first                         ; int
    t1 = &__va_args                      ; char*
    ap = t1                              ; char*
L9:
    t2 = 4 + 3                           ; int
    t3 = t2 / 4                          ; int
    t4 = t3 * 4                          ; int
    t5 = ap + t4                         ; char*
    ap = t5                              ; char*
    t6 = 4 + 3                           ; int
    t7 = t6 / 4                          ; int
    t8 = t7 * 4                          ; int
    t9 = t5 - t8                         ; char*
    t10 = (int*) t9                      ; int*
    t11 = *t10                           ; int
    v = t11                              ; int
    t12 = t11 != -1                      ; int
    ifFalse t12 goto L10
    t13 = v > best                       ; int
    ifFalse t13 goto L11
    best = v                             ; int
L11:
    goto L9
L10:
    t14 = (char*) 0                      ; char*
    ap = t14                             ; char*
    return best                          ; int
endfunction

