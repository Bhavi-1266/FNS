    t6 = t + 8                           ; struct Tree**
    t7 = (void*) 0                       ; void*
    t8 = (struct Tree*) t7               ; struct Tree*
    *t6 = t8                             ; struct Tree*
    *t5 = t8                             ; struct Tree*
    goto L4
L3:
    t9 = *t                              ; int
    t10 = k < t9                         ; int
    ifFalse t10 goto L5
    t11 = t + 4                          ; struct Tree**
    t12 = t + 4                          ; struct Tree**
    t13 = *t12                           ; struct Tree*
    param t13
    param k
    t14 = call insert, 2                 ; struct Tree*
    *t11 = t14                           ; struct Tree*
    goto L6
L5:
    t15 = t + 8                          ; struct Tree**
    t16 = t + 8                          ; struct Tree**
    t17 = *t16                           ; struct Tree*
    param t17
    param k
    t18 = call insert, 2                 ; struct Tree*
    *t15 = t18                           ; struct Tree*
L6:
L4:
    return t                             ; struct Tree*
endfunction

function inorder(struct Tree* t) : void
    ifFalse t goto L7
    t1 = t + 4                           ; struct Tree**
    t2 = *t1                             ; struct Tree*
    param t2
    call inorder, 1
    t3 = *t                              ; int
    param str0
    param t3
    t4 = call printf, 2                  ; int
    t5 = t + 8                           ; struct Tree**
    t6 = *t5                             ; struct Tree*
    param t6
    call inorder, 1
L7:
    return
endfunction

function height(struct Tree* t) : int
    local l : int (4)
    local r : int (4)
    t1 = ! t                             ; int
    ifFalse t1 goto L8
    return 0                             ; int
L8:
    t2 = t + 4                           ; struct Tree**
    t3 = *t2                             ; struct Tree*
    param t3
    t4 = call height, 1                  ; int
    l = t4                               ; int
    t5 = t + 8                           ; struct Tree**
    t6 = *t5                             ; struct Tree*
    param t6
    t7 = call height, 1                  ; int
    r = t7                               ; int
    t9 = l > r                           ; int
    ifFalse t9 goto L9
    t8 = l                               ; int
    goto L10
L9:
    t8 = r                               ; int
L10:
    t10 = 1 + t8                         ; int
    return t10                           ; int
endfunction

function free_tree(struct Tree* t) : void
    ifFalse t goto L11
    t1 = t + 4                           ; struct Tree**
    t2 = *t1                             ; struct Tree*
    param t2
    call free_tree, 1
    t3 = t + 8                           ; struct Tree**
    t4 = *t3                             ; struct Tree*
    param t4
    call free_tree, 1
    param t
    call free, 1
L11:
    return
endfunction

