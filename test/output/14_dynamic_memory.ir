function push_front(struct Node* head, int v) : struct Node*
    local n : struct Node* (4)
    t1 = (unsigned int) 8                ; unsigned int
    param t1
    t2 = call malloc, 1                  ; void*
    t3 = (struct Node*) t2               ; struct Node*
    n = t3                               ; struct Node*
    *n = v                               ; int
    t4 = n + 4                           ; struct Node**
    *t4 = head                           ; struct Node*
    return n                             ; struct Node*
endfunction

function reverse(struct Node* head) : struct Node*
    local prev : struct Node* (4)
    local next : struct Node* (4)
    t1 = (void*) 0                       ; void*
    t2 = (struct Node*) t1               ; struct Node*
    prev = t2                            ; struct Node*
L1:
    ifFalse head goto L2
    t3 = head + 4                        ; struct Node**
    t4 = *t3                             ; struct Node*
    next = t4                            ; struct Node*
    t5 = head + 4                        ; struct Node**
    *t5 = prev                           ; struct Node*
    prev = head                          ; struct Node*
    head = next                          ; struct Node*
    goto L1
L2:
    return prev                          ; struct Node*
endfunction

