    param 7.0
    t3 = call lambda_3, 1                ; double
    param str0
    param t1
    param t2
    param t3
    t4 = call printf, 4                  ; int
    base = 10                            ; int
    counter = 0                          ; int
    lambda_4_cap_base = base             ; int
    base = 1000                          ; int
    param 5
    param lambda_4_cap_base
    t5 = call lambda_4, 2                ; int
    param str1
    param t5
    param base
    t6 = call printf, 3                  ; int
    t7 = &counter                        ; int*
    lambda_5_cap_counter = t7            ; int*
    param lambda_5_cap_counter
    call lambda_5, 1
    param lambda_5_cap_counter
    call lambda_5, 1
    param lambda_5_cap_counter
    call lambda_5, 1
    param str2
    param counter
    t8 = call printf, 2                  ; int
    a = 3                                ; int
    b = 4                                ; int
    lambda_6_cap_a = a                   ; int
    lambda_6_cap_b = b                   ; int
    t9 = &a                              ; int*
    lambda_7_cap_a = t9                  ; int*
    t10 = &b                             ; int*
    lambda_7_cap_b = t10                 ; int*
    param lambda_7_cap_a
    param lambda_7_cap_b
    call lambda_7, 2
    param lambda_6_cap_a
    param lambda_6_cap_b
    t11 = call lambda_6, 2               ; int
    param str3
    param t11
    param a
    param b
    t12 = call printf, 4                 ; int
    scale = 2                            ; int
    total = 0                            ; int
    t13 = &total                         ; int*
    lambda_8_cap_total = t13             ; int*
    lambda_8_cap_scale = scale           ; int
    param 5
    param lambda_8_cap_total
    param lambda_8_cap_scale
    call lambda_8, 3
    param 7
    param lambda_8_cap_total
    param lambda_8_cap_scale
    call lambda_8, 3
    param str4
    param total
    t14 = call printf, 2                 ; int
    param 20
    param 8
    t15 = call lambda_9, 2               ; int
    r = t15                              ; int
    param str5
    param r
    t16 = call printf, 2                 ; int
    t17 = (fn*) lambda_1                 ; fn*
    param t17
    param 12
    t18 = call apply, 2                  ; int
    param str6
    param t18
    t19 = call printf, 2                 ; int
    t20 = (fn*) lambda_10                ; fn*
    param 3
    param t20
    call repeat, 2
    param str8
    t21 = call printf, 1                 ; int
    evens = 0                            ; int
    i = 0                                ; int
L4:
    t22 = i < 10                         ; int
    ifFalse t22 goto L6
    param i
    t23 = call lambda_11, 1              ; bool
    ifFalse t23 goto L7
    t24 = evens + 1                      ; int
    evens = t24                          ; int
L7:
L5:
    t25 = i + 1                          ; int
    i = t25                              ; int
    goto L4
L6:
    param str9
    param evens
    t26 = call printf, 2                 ; int
    param 4
    param 19
    param 7
    t27 = call lambda_12, 3              ; int
    param str10
    param t27
    t28 = call printf, 2                 ; int
    t29 = &pair                          ; int*
    *t29 = 0                             ; int
    t30 = t29 + 4                        ; int*
    *t30 = 0                             ; int
    *t29 = 5                             ; int
    t31 = t29 + 4                        ; int*
    *t31 = 9                             ; int
    param 5.0
    t32 = call lambda_13, 1              ; double
    param str13
    t33 = call lambda_14, 1              ; char
    t34 = (int) t33                      ; int
    t35 = &pair                          ; int*
    t36 = (int*) t35                     ; int*
    param t36
    t37 = call lambda_15, 1              ; int*
    t38 = *t37                           ; int
    param str12
    param t32
    param t34
    param t38
    t39 = call printf, 4                 ; int
    param str14
    call lambda_16, 1
    seed = 10                            ; int
    sum = 0                              ; int
    lambda_17_cap_seed_copy = seed       ; int
    lambda_17_cap_seed = &lambda_17_cap_seed_copy ; int*
    param lambda_17_cap_seed
    t40 = call lambda_17, 1              ; int
    c1 = t40                             ; int
    param lambda_17_cap_seed
    t41 = call lambda_17, 1              ; int
    c2 = t41                             ; int
    lambda_18_cap_seed_copy = seed       ; int
    lambda_18_cap_seed = &lambda_18_cap_seed_copy ; int*
    t42 = &sum                           ; int*
    lambda_18_cap_sum = t42              ; int*
    param 5
    param lambda_18_cap_seed
    param lambda_18_cap_sum
    t43 = call lambda_18, 3              ; int
    s1 = t43                             ; int
    param 5
