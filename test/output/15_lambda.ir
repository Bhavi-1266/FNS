; FNS three-address code
; source: test/15_lambda.cpp

.data
    str0: "%d %d %.2f\n"
    str1: "by value: %d (base is now %d)\n"
    str2: "by reference: counter=%d\n"
    str3: "[=] saw %d, after [&]: a=%d b=%d\n"
    str4: "mixed: total=%d\n"
    str5: "immediate: %d\n"
    str6: "callback: %d\n"
    str7: "tick %d "
    str8: "\n"
    str9: "evens=%d\n"
    str10: "max3=%d\n"
    str11: "%s!\n"
    str12: "deduced: %.2f %c %d\n"
    str13: "xyz"
    str14: "done"
    str15: "mutable: %d %d | %d %d sum=%d seed=%d\n"
    str16: "fresh %d\n"

.extern
    printf

.text

function apply(fn* f, int v) : int
    param v
    t1 = call *f, 1                      ; int
    return t1                            ; int
endfunction

function repeat(int n, fn* f) : void
    local i : int (4)
    i = 0                                ; int
L1:
    t1 = i < n                           ; int
    ifFalse t1 goto L3
    param i
    call *f, 1
L2:
    t2 = i + 1                           ; int
    i = t2                               ; int
    goto L1
L3:
    return
endfunction

function lambda_1(int x) : int
    t1 = x * x                           ; int
    return t1                            ; int
endfunction

function lambda_2(int a, int b) : int
    t1 = a + b                           ; int
    return t1                            ; int
endfunction

function lambda_3(double d) : double
    t1 = (double) 2                      ; double
    t2 = d / t1                          ; double
    return t2                            ; double
endfunction

function lambda_4(int x, int cap_base) : int
    t1 = x + cap_base                    ; int
    return t1                            ; int
endfunction

function lambda_5(int* cap_counter) : void
    t1 = *cap_counter                    ; int
    t2 = t1 + 1                          ; int
    *cap_counter = t2                    ; int
    return
endfunction

function lambda_6(int cap_a, int cap_b) : int
    t1 = cap_a * cap_b                   ; int
    return t1                            ; int
endfunction

function lambda_7(int* cap_a, int* cap_b) : void
    t1 = *cap_a                          ; int
    t2 = t1 + 10                         ; int
    *cap_a = t2                          ; int
    t3 = *cap_b                          ; int
    t4 = t3 + 10                         ; int
    *cap_b = t4                          ; int
    return
endfunction

function lambda_8(int v, int* cap_total, int cap_scale) : void
    t1 = *cap_total                      ; int
    t2 = v * cap_scale                   ; int
    t3 = t1 + t2                         ; int
    *cap_total = t3                      ; int
    return
endfunction

function lambda_9(int x, int y) : int
    t1 = x - y                           ; int
    return t1                            ; int
endfunction

function lambda_10(int i) : void
    param str7
    param i
    t1 = call printf, 2                  ; int
    return
endfunction

function lambda_11(int n) : bool
    t1 = n % 2                           ; int
    t2 = t1 == 0                         ; int
    t3 = (bool) t2                       ; bool
    return t3                            ; bool
endfunction

function lambda_12(int x, int y, int z) : int
    local m : int (4)
    m = x                                ; int
    t1 = y > m                           ; int
    ifFalse t1 goto L8
    m = y                                ; int
L8:
    t2 = z > m                           ; int
    ifFalse t2 goto L9
    m = z                                ; int
L9:
    return m                             ; int
endfunction

function lambda_13(double d) : double
    t1 = (double) 2                      ; double
    t2 = d / t1                          ; double
    return t2                            ; double
endfunction

function lambda_14(char* s) : char
    t1 = *s                              ; char
    return t1                            ; char
endfunction

function lambda_15(int* p) : int*
    t1 = 1 * 4                           ; int
    t2 = p + t1                          ; int*
    return t2                            ; int*
endfunction

function lambda_16(char* s) : void
    param str11
    param s
    t1 = call printf, 2                  ; int
    return
endfunction

function lambda_17(int* cap_seed) : int
    t1 = *cap_seed                       ; int
    t2 = t1 + 1                          ; int
    *cap_seed = t2                       ; int
    t3 = *cap_seed                       ; int
    return t3                            ; int
endfunction

function lambda_18(int k, int* cap_seed, int* cap_sum) : int
    t1 = *cap_seed                       ; int
    t2 = t1 + k                          ; int
    *cap_seed = t2                       ; int
    t3 = *cap_sum                        ; int
    t4 = t3 + k                          ; int
    *cap_sum = t4                        ; int
    t5 = *cap_seed                       ; int
    return t5                            ; int
endfunction

function lambda_19(int* cap_i) : int
    t1 = *cap_i                          ; int
    t2 = t1 + 100                        ; int
    *cap_i = t2                          ; int
    t3 = *cap_i                          ; int
    return t3                            ; int
endfunction

