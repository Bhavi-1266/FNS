    param s1
    param s2
    param sum
    param seed
    t45 = call printf, 7                 ; int
    i_1 = 0                              ; int
L10:
    t46 = i_1 < 2                        ; int
    ifFalse t46 goto L12
    lambda_19_cap_i_copy = i_1           ; int
    lambda_19_cap_i = &lambda_19_cap_i_copy ; int*
    param lambda_19_cap_i
    t47 = call lambda_19, 1              ; int
    f = t47                              ; int
    param str16
    param f
    t48 = call printf, 2                 ; int
L11:
    t49 = i_1 + 1                        ; int
    i_1 = t49                            ; int
    goto L10
L12:
    return 0                             ; int
endfunction
