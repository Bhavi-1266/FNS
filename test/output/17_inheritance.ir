; FNS three-address code
; source: test/17_inheritance.cpp

.data
    str0: "Shape(%s) "
    str1: "~Shape(%s) "
    str2: "%s with area %.2f\n"
    str3: "circle"
    str4: "Circle "
    str5: "~Circle "
    str6: "rect"
    str7: "Rect "
    str8: "square"
    str9: "Square "
    str10: "[square side %.1f] "
    str11: "..."
    str12: "animal"
    str13: "%s says %s\n"
    str14: "woof"
    str15: "dog"
    str16: "yip"
    str17: "\n"
    str18: "total area %.2f\n"
    str19: "%s %s\n"
    str20: "through reference: %s\n"
    str21: "struct base: %d %d %d, class base: %d\n"
    vtable_Shape: Shape__dtor, __pure_virtual, Shape_describe
    vtable_Circle: Circle__dtor, Circle_area, Shape_describe
    vtable_Rect: Rect__dtor, Rect_area, Shape_describe
    vtable_Square: Square__dtor, Rect_area, Square_describe
    vtable_Animal: Animal_sound
    vtable_Dog: Dog_sound
    vtable_Puppy: Puppy_sound

.extern
    printf
    __fns_new
    free

.text

function Shape_Shape(Shape* this, char* n) : void
    t1 = &vtable_Shape                   ; ptr
    *this = t1                           ; ptr
    t2 = this + 4                        ; char**
    *t2 = n                              ; char*
    t3 = this + 4                        ; char**
    t4 = *t3                             ; char*
    param str0
    param t4
    t5 = call printf, 2                  ; int
    return
endfunction

function Shape__dtor(Shape* this) : void
    t1 = &vtable_Shape                   ; ptr
    *this = t1                           ; ptr
    t2 = this + 4                        ; char**
    t3 = *t2                             ; char*
    param str1
    param t3
    t4 = call printf, 2                  ; int
    return
endfunction

function Shape_describe(Shape* this) : void
    t1 = this + 4                        ; char**
    t2 = *t1                             ; char*
    t3 = *this                           ; ptr
    t4 = t3 + 4                          ; ptr
    t5 = *t4                             ; fn*
    param this
    t6 = call *t5, 1                     ; double
    param str2
    param t2
    param t6
    t7 = call printf, 3                  ; int
    return
endfunction

function Shape_get_name(Shape* this) : char*
    t1 = this + 4                        ; char**
    t2 = *t1                             ; char*
    return t2                            ; char*
endfunction

function Circle_Circle(Circle* this, double radius) : void
    param this
    param str3
    call Shape_Shape, 2
    t1 = &vtable_Circle                  ; ptr
    *this = t1                           ; ptr
    t2 = this + 8                        ; double*
    *t2 = radius                         ; double
    param str4
    t3 = call printf, 1                  ; int
    return
endfunction

function Circle__dtor(Circle* this) : void
    t1 = &vtable_Circle                  ; ptr
    *this = t1                           ; ptr
    param str5
    t2 = call printf, 1                  ; int
    param this
    call Shape__dtor, 1
    return
endfunction

function Circle_area(Circle* this) : double
    t1 = this + 8                        ; double*
    t2 = *t1                             ; double
    t3 = 3.14 * t2                       ; double
    t4 = this + 8                        ; double*
    t5 = *t4                             ; double
    t6 = t3 * t5                         ; double
    return t6                            ; double
endfunction

function Rect_Rect(Rect* this, double a, double b) : void
    param this
    param str6
    call Shape_Shape, 2
    t1 = &vtable_Rect                    ; ptr
    *this = t1                           ; ptr
    t2 = this + 8                        ; double*
    *t2 = a                              ; double
    t3 = this + 16                       ; double*
    *t3 = b                              ; double
    param str7
    t4 = call printf, 1                  ; int
    return
endfunction

function Rect_Rect__1(Rect* this, char* n, double a, double b) : void
    param this
    param n
    call Shape_Shape, 2
    t1 = &vtable_Rect                    ; ptr
    *this = t1                           ; ptr
    t2 = this + 8                        ; double*
    *t2 = a                              ; double
    t3 = this + 16                       ; double*
    *t3 = b                              ; double
    param str7
    t4 = call printf, 1                  ; int
    return
endfunction

function Rect_area(Rect* this) : double
    t1 = this + 8                        ; double*
    t2 = *t1                             ; double
    t3 = this + 16                       ; double*
    t4 = *t3                             ; double
    t5 = t2 * t4                         ; double
    return t5                            ; double
endfunction

function Rect__dtor(Rect* this) : void
    t1 = &vtable_Rect                    ; ptr
    *this = t1                           ; ptr
    param this
    call Shape__dtor, 1
    return
endfunction

function Square_Square(Square* this, double s) : void
    param this
    param str8
    param s
    param s
    call Rect_Rect__1, 4
    t1 = &vtable_Square                  ; ptr
    *this = t1                           ; ptr
    param str9
    t2 = call printf, 1                  ; int
    return
endfunction

function Square_describe(Square* this) : void
    t1 = this + 8                        ; double*
    t2 = *t1                             ; double
    param str10
    param t2
    t3 = call printf, 2                  ; int
    param this
    call Shape_describe, 1
    return
endfunction

function Square__dtor(Square* this) : void
    t1 = &vtable_Square                  ; ptr
    *this = t1                           ; ptr
    param this
    call Rect__dtor, 1
    return
endfunction

function Animal_sound(Animal* this) : char*
    return str11                         ; char*
endfunction

function Animal_kind(Animal* this) : char*
    return str12                         ; char*
endfunction

function Animal_speak(Animal* this) : void
    param this
    t1 = call Animal_kind, 1             ; char*
    t2 = *this                           ; ptr
    t3 = *t2                             ; fn*
    param this
    t4 = call *t3, 1                     ; char*
    param str13
    param t1
    param t4
    t5 = call printf, 3                  ; int
    return
endfunction

function Animal_Animal(Animal* this) : void
    t1 = &vtable_Animal                  ; ptr
    *this = t1                           ; ptr
    return
endfunction

function Dog_sound(Dog* this) : char*
    return str14                         ; char*
endfunction

function Dog_kind(Dog* this) : char*
    return str15                         ; char*
endfunction

function Dog_Dog(Dog* this) : void
    param this
    call Animal_Animal, 1
    t1 = &vtable_Dog                     ; ptr
    *this = t1                           ; ptr
    return
endfunction

function Puppy_sound(Puppy* this) : char*
    return str16                         ; char*
endfunction

function Puppy_Puppy(Puppy* this) : void
    param this
    call Dog_Dog, 1
    t1 = &vtable_Puppy                   ; ptr
    *this = t1                           ; ptr
    return
endfunction

function total_area(Shape** shapes, int n) : double
    local t : double (8)
    local i : int (4)
    t1 = (double) 0                      ; double
    t = t1                               ; double
    i = 0                                ; int
L1:
    t2 = i < n                           ; int
    ifFalse t2 goto L3
    t3 = i * 4                           ; int
    t4 = shapes + t3                     ; Shape**
    t5 = *t4                             ; Shape*
    t6 = *t5                             ; ptr
    t7 = t6 + 4                          ; ptr
    t8 = *t7                             ; fn*
    param t5
    t9 = call *t8, 1                     ; double
    t10 = t + t9                         ; double
    t = t10                              ; double
L2:
    t11 = i + 1                          ; int
    i = t11                              ; int
    goto L1
L3:
    return t                             ; double
endfunction

function show_ref(Shape& s) : void
    t1 = *s                              ; ptr
    t2 = t1 + 8                          ; ptr
    t3 = *t2                             ; fn*
    param s
    call *t3, 1
    return
endfunction

function Point2_sum(struct Point2* this) : int
    t1 = *this                           ; int
    t2 = this + 4                        ; int*
    t3 = *t2                             ; int
    t4 = t1 + t3                         ; int
    return t4                            ; int
endfunction

function Point2_Point2(struct Point2* this) : void
    *this = 1                            ; int
    t1 = this + 4                        ; int*
    *t1 = 2                              ; int
    return
endfunction

function Point3_sum3(struct Point3* this) : int
    param this
    t1 = call Point2_sum, 1              ; int
    t2 = this + 8                        ; int*
    t3 = *t2                             ; int
    t4 = t1 + t3                         ; int
    return t4                            ; int
endfunction

function Point3_Point3(struct Point3* this) : void
    param this
    call Point2_Point2, 1
    t1 = this + 8                        ; int*
    *t1 = 3                              ; int
    return
endfunction

function Hidden2_total(Hidden2* this) : int
    param this
    t1 = call Point2_sum, 1              ; int
    t2 = t1 * 10                         ; int
    return t2                            ; int
endfunction

function Hidden2_Hidden2(Hidden2* this) : void
    param this
    call Point2_Point2, 1
    return
endfunction

function main() : int
    local shapes : Shape[3]* (12)
    local i : int (4)
    local sq : Square (24)
    local i_1 : int (4)
    local a : Animal (4)
    local d : Dog (4)
    local p : Puppy (4)
    local zoo : Animal[3]* (12)
    local i_2 : int (4)
    local ref : Animal& (4)
    local p3 : struct Point3 (12)
    local h2 : Hidden2 (8)
    t1 = &shapes                         ; Shape**
    param 1
    param 16
    param 0
    t2 = call __fns_new, 3               ; void*
    param t2
    param 1.0
    call Circle_Circle, 2
    t3 = (Shape*) t2                     ; Shape*
    *t1 = t3                             ; Shape*
    param str17
    t4 = call printf, 1                  ; int
    t5 = &shapes                         ; Shape**
    t6 = t5 + 4                          ; Shape**
    param 1
    param 24
    param 0
    t7 = call __fns_new, 3               ; void*
    param t7
    param 2.0
    param 3.0
    call Rect_Rect, 3
    t8 = (Shape*) t7                     ; Shape*
    *t6 = t8                             ; Shape*
    param str17
    t9 = call printf, 1                  ; int
    t10 = &shapes                        ; Shape**
    t11 = t10 + 8                        ; Shape**
    param 1
    param 24
    param 0
    t12 = call __fns_new, 3              ; void*
    param t12
    param 2.5
    call Square_Square, 2
    t13 = (Shape*) t12                   ; Shape*
    *t11 = t13                           ; Shape*
    param str17
    t14 = call printf, 1                 ; int
    i = 0                                ; int
L4:
    t15 = i < 3                          ; int
    ifFalse t15 goto L6
    t16 = &shapes                        ; Shape**
    t17 = i * 4                          ; int
    t18 = t16 + t17                      ; Shape**
    t19 = *t18                           ; Shape*
    t20 = *t19                           ; ptr
    t21 = t20 + 8                        ; ptr
    t22 = *t21                           ; fn*
    param t19
    call *t22, 1
L5:
    t23 = i + 1                          ; int
    i = t23                              ; int
    goto L4
L6:
    t24 = &shapes                        ; Shape**
    t25 = (Shape**) t24                  ; Shape**
    param t25
    param 3
    t26 = call total_area, 2             ; double
    param str18
    param t26
    t27 = call printf, 2                 ; int
    t28 = &sq                            ; Square*
    param t28
    param 1.5
    call Square_Square, 2
    param str17
    t29 = call printf, 1                 ; int
    t30 = &sq                            ; Square*
    param t30
    call show_ref, 1
    i_1 = 0                              ; int
L7:
    t31 = i_1 < 3                        ; int
    ifFalse t31 goto L9
    t32 = &shapes                        ; Shape**
    t33 = i_1 * 4                        ; int
    t34 = t32 + t33                      ; Shape**
    t35 = *t34                           ; Shape*
    ifFalse t35 goto L10
    t36 = *t35                           ; ptr
    t37 = *t36                           ; fn*
    param t35
    call *t37, 1
    param t35
    call free, 1
L10:
    param str17
    t38 = call printf, 1                 ; int
L8:
    t39 = i_1 + 1                        ; int
    i_1 = t39                            ; int
    goto L7
L9:
    t40 = &a                             ; Animal*
    param t40
    call Animal_Animal, 1
    t41 = &d                             ; Dog*
    param t41
    call Dog_Dog, 1
    t42 = &p                             ; Puppy*
    param t42
    call Puppy_Puppy, 1
    t43 = &zoo                           ; Animal**
    *t43 = 0                             ; Animal*
    t44 = t43 + 4                        ; Animal**
    *t44 = 0                             ; Animal*
    t45 = t43 + 8                        ; Animal**
    *t45 = 0                             ; Animal*
    t46 = &a                             ; Animal*
    *t43 = t46                           ; Animal*
    t47 = t43 + 4                        ; Animal**
    t48 = &d                             ; Dog*
    t49 = (Animal*) t48                  ; Animal*
    *t47 = t49                           ; Animal*
    t50 = t43 + 8                        ; Animal**
    t51 = &p                             ; Puppy*
    t52 = (Animal*) t51                  ; Animal*
    *t50 = t52                           ; Animal*
    i_2 = 0                              ; int
L11:
    t53 = i_2 < 3                        ; int
    ifFalse t53 goto L13
    t54 = &zoo                           ; Animal**
    t55 = i_2 * 4                        ; int
    t56 = t54 + t55                      ; Animal**
    t57 = *t56                           ; Animal*
    param t57
    call Animal_speak, 1
L12:
    t58 = i_2 + 1                        ; int
    i_2 = t58                            ; int
    goto L11
L13:
    t59 = &d                             ; Dog*
    param t59
    t60 = call Dog_kind, 1               ; char*
    t61 = &d                             ; Dog*
    t62 = *t61                           ; ptr
    t63 = *t62                           ; fn*
    param t61
    t64 = call *t63, 1                   ; char*
    param str19
    param t60
    param t64
    t65 = call printf, 3                 ; int
    t66 = &p                             ; Puppy*
    ref = t66                            ; Animal*
    t67 = *ref                           ; ptr
    t68 = *t67                           ; fn*
    param ref
    t69 = call *t68, 1                   ; char*
    param str20
    param t69
    t70 = call printf, 2                 ; int
    t71 = &p3                            ; struct Point3*
    param t71
    call Point3_Point3, 1
    t72 = &h2                            ; Hidden2*
    param t72
    call Hidden2_Hidden2, 1
    t73 = &p3                            ; struct Point3*
    t74 = *t73                           ; int
    t75 = &p3                            ; struct Point3*
    param t75
    t76 = call Point2_sum, 1             ; int
    t77 = &p3                            ; struct Point3*
    param t77
    t78 = call Point3_sum3, 1            ; int
    t79 = &h2                            ; Hidden2*
    param t79
    t80 = call Hidden2_total, 1          ; int
    param str21
    param t74
    param t76
    param t78
    param t80
    t81 = call printf, 5                 ; int
    t82 = &sq                            ; Square*
    param t82
    call Square__dtor, 1
    return 0                             ; int
endfunction
