; FNS three-address code
; source: test/19_references.cpp

.data
    str0: "lvalue"
    str1: "rvalue"
    str2: "acquire %d\n"
    str3: "copy %d\n"
    str4: "move %d\n"
    str5: "release %d\n"
    str6: "release (empty)\n"
    str7: "x=%d rx=%d\n"
    str8: "x=%d\n"
    str9: "after swap x=%d y=%d\n"
    str10: "d=%.1f\n"
    str11: "arr[1]=%d\n"
    str12: "arr[2]=%d\n"
    str13: "const ref sum=%d %d\n"
    str14: "balance=%d\n"
    str15: "box b=%d c=%d\n"
    str16: "p is %s\n"
    str17: "null"
    str18: "set"
    str19: "arr[0]=%d\n"
    str20: "rvalue refs: %d %d %s %s %s\n"
    str21: "h1 empty: %d, h3 empty: %d\n"

.extern
    __fns_new
    printf
    free

.text

function swap(int& a, int& b) : void
    local t : int (4)
    t1 = *a                              ; int
    t = t1                               ; int
    t2 = *b                              ; int
    *a = t2                              ; int
    *b = t                               ; int
    return
endfunction

function triple(double& d) : void
    t1 = *d                              ; double
    t2 = (double) 3                      ; double
    t3 = t1 * t2                         ; double
    *d = t3                              ; double
    return
endfunction

function element(int* arr, int i) : int&
    t1 = i * 4                           ; int
    t2 = arr + t1                        ; int*
    return t2                            ; int*
endfunction

function sum_const(int& a, int& b) : int
    t1 = *a                              ; int
    t2 = *b                              ; int
    t3 = t1 + t2                         ; int
    return t3                            ; int
endfunction

function deposit(struct Account& acc, int amt) : void
    t1 = *acc                            ; int
    t2 = t1 + amt                        ; int
    *acc = t2                            ; int
    return
endfunction

function Box_Box(Box* this, int x) : void
    *this = x                            ; int
    return
endfunction

function Box_value(Box* this) : int&
    return this                          ; int*
endfunction

function Box_copy_from(Box* this, Box& other) : void
    t1 = *other                          ; int
    *this = t1                           ; int
    return
endfunction

function reset_ptr(int*& p) : void
    t1 = (int*) 0                        ; int*
    *p = t1                              ; int*
    return
endfunction

function category(int& arg0) : char*
    return str0                          ; char*
endfunction

function category__1(int&& arg0) : char*
    return str1                          ; char*
endfunction

function bump(int&& x) : int
    t1 = *x                              ; int
    t2 = t1 + 100                        ; int
    *x = t2                              ; int
    t3 = *x                              ; int
    return t3                            ; int
endfunction

function Holder_Holder(Holder* this, int v) : void
    param 1
    param 4
    param 0
    t1 = call __fns_new, 3               ; void*
    *t1 = v                              ; int
    *this = t1                           ; int*
    param str2
    param v
    t2 = call printf, 2                  ; int
    return
endfunction

function Holder_Holder__1(Holder* this, Holder& o) : void
    param 1
    param 4
    param 0
    t1 = call __fns_new, 3               ; void*
    t2 = *o                              ; int*
    t3 = *t2                             ; int
    *t1 = t3                             ; int
    *this = t1                           ; int*
    t4 = *this                           ; int*
    t5 = *t4                             ; int
    param str3
    param t5
    t6 = call printf, 2                  ; int
    return
endfunction

function Holder_Holder__2(Holder* this, Holder&& o) : void
    t1 = *o                              ; int*
    *this = t1                           ; int*
    t2 = (int*) 0                        ; int*
    *o = t2                              ; int*
    t3 = *this                           ; int*
    t4 = *t3                             ; int
    param str4
    param t4
    t5 = call printf, 2                  ; int
    return
endfunction

function Holder__dtor(Holder* this) : void
    t1 = *this                           ; int*
    ifFalse t1 goto L1
    t2 = *this                           ; int*
    t3 = *t2                             ; int
    param str5
    param t3
    t4 = call printf, 2                  ; int
    t5 = *this                           ; int*
    param t5
    call free, 1
    goto L2
L1:
    param str6
    t6 = call printf, 1                  ; int
L2:
    return
endfunction

function Holder_empty(Holder* this) : bool
    t1 = *this                           ; int*
    t2 = (int*) 0                        ; int*
    t3 = t1 == t2                        ; int
    t4 = (bool) t3                       ; bool
    return t4                            ; bool
endfunction

