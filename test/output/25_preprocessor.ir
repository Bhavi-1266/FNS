; FNS three-address code
; source: test/25_preprocessor.c

.data
    str0: "%d %d %d\n"
    str1: "max=%d area=%.3f\n"
    str2: "%s %s\n"
    str3: "hello"
    str4: "1 + 2"
    str5: "var42=%d\n"
    str6: "x=%d y=%d\n"
    str7: "%d + %d = %d\n"
    str8: "debug on\n"
    str9: "not a release build\n"
    str10: "version 3+\n"
    str11: "NULL=%d EOF=%d INT_MAX=%d INT_MIN=%d\n"
    str12: "SQUARE(1+2)=%d\n"

.extern
    printf

.text

function main() : int
    local arr : int[5] (20)
    local i : int (4)
    local var42 : int (4)
    local x : int (4)
    local y : int (4)
    local tmp_ : int (4)
    local p : int* (4)
    i = 0                                ; int
L1:
    t1 = i < 5                           ; int
    ifFalse t1 goto L3
    t2 = &arr                            ; int*
    t3 = i * 4                           ; int
    t4 = t2 + t3                         ; int*
    t5 = i + 1                           ; int
    t6 = i + 1                           ; int
    t7 = t5 * t6                         ; int
    *t4 = t7                             ; int
L2:
    t8 = i + 1                           ; int
    i = t8                               ; int
    goto L1
L3:
    t9 = &arr                            ; int*
    t10 = *t9                            ; int
    t11 = &arr                           ; int*
    t12 = 5 - 1                          ; int
    t13 = t12 * 4                        ; int
    t14 = t11 + t13                      ; int*
    t15 = *t14                           ; int
    t16 = 20 / 4                         ; int
    t17 = (int) t16                      ; int
    param str0
    param t10
    param t15
    param t17
    t18 = call printf, 4                 ; int
    t20 = 5 * 2                          ; int
    t21 = 7 > t20                        ; int
    ifFalse t21 goto L4
    t19 = 7                              ; int
    goto L5
L4:
    t22 = 5 * 2                          ; int
    t19 = t22                            ; int
L5:
    t23 = 2.0 * 2.0                      ; double
    t24 = 3.14159 * t23                  ; double
    param str1
    param t19
    param t24
    t25 = call printf, 3                 ; int
    param str2
    param str3
    param str4
    t26 = call printf, 3                 ; int
    var42 = 9                            ; int
    param str5
    param var42
    t27 = call printf, 2                 ; int
    x = 1                                ; int
    y = 2                                ; int
L6:
    tmp_ = x                             ; int
    x = y                                ; int
    y = tmp_                             ; int
L7:
    if 0 goto L6
L8:
    param str6
    param x
    param y
    t28 = call printf, 3                 ; int
    t29 = 20 + 22                        ; int
    param str7
    param 20
    param 22
    param t29
    t30 = call printf, 4                 ; int
    param str8
    t31 = call printf, 1                 ; int
    param str9
    t32 = call printf, 1                 ; int
    param str10
    t33 = call printf, 1                 ; int
    t34 = (void*) 0                      ; void*
    t35 = (int*) t34                     ; int*
    p = t35                              ; int*
    t36 = (void*) 0                      ; void*
    t37 = (int*) t36                     ; int*
    t38 = p == t37                       ; int
    t39 = -2147483647 - 1                ; int
    param str11
    param t38
    param -1
    param 2147483647
    param t39
    t40 = call printf, 5                 ; int
    t41 = 1 + 2                          ; int
    t42 = 1 + 2                          ; int
    t43 = t41 * t42                      ; int
    param str12
    param t43
    t44 = call printf, 2                 ; int
    return 0                             ; int
endfunction
