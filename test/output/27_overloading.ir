; FNS three-address code
; source: test/27_overloading.cpp

.data
    str0: "int %d\n"
    str1: "double %.2f\n"
    str2: "string %s\n"
    str3: "char %c\n"
    str4: "(%d,%d)\n"
    str5: "%d %d %.1f\n"
    str6: "text"
    str7: "dot=%d scaled=%d\n"

.extern
    printf

.text

function area(int side) : int
    t1 = side * side                     ; int
    return t1                            ; int
endfunction

function area__1(int w, int h) : int
    t1 = w * h                           ; int
    return t1                            ; int
endfunction

function area__2(double r) : double
    t1 = 3.0 * r                         ; double
    t2 = t1 * r                          ; double
    return t2                            ; double
endfunction

function print(int v) : void
    param str0
    param v
    t1 = call printf, 2                  ; int
    return
endfunction

function print__1(double v) : void
    param str1
    param v
    t1 = call printf, 2                  ; int
    return
endfunction

function print__2(char* s) : void
    param str2
    param s
    t1 = call printf, 2                  ; int
    return
endfunction

function print__3(char c) : void
    t1 = (int) c                         ; int
    param str3
    param t1
    t2 = call printf, 2                  ; int
    return
endfunction

function Vec_Vec(Vec* this) : void
    *this = 0                            ; int
    t1 = this + 4                        ; int*
    *t1 = 0                              ; int
    return
endfunction

function Vec_Vec__1(Vec* this, int v) : void
    *this = v                            ; int
    t1 = this + 4                        ; int*
    *t1 = v                              ; int
    return
endfunction

function Vec_Vec__2(Vec* this, int a, int b) : void
    *this = a                            ; int
    t1 = this + 4                        ; int*
    *t1 = b                              ; int
    return
endfunction

function Vec_set(Vec* this, int v) : void
    t1 = this + 4                        ; int*
    *t1 = v                              ; int
    *this = v                            ; int
    return
endfunction

function Vec_set__1(Vec* this, int a, int b) : void
    *this = a                            ; int
    t1 = this + 4                        ; int*
    *t1 = b                              ; int
    return
endfunction

function Vec_dot(Vec* this, Vec& o) : int
    t1 = *this                           ; int
    t2 = *o                              ; int
    t3 = t1 * t2                         ; int
    t4 = this + 4                        ; int*
    t5 = *t4                             ; int
    t6 = o + 4                           ; int*
    t7 = *t6                             ; int
    t8 = t5 * t7                         ; int
    t9 = t3 + t8                         ; int
    return t9                            ; int
endfunction

function Vec_dot__1(Vec* this, int k) : int
    t1 = *this                           ; int
    t2 = this + 4                        ; int*
    t3 = *t2                             ; int
    t4 = t1 + t3                         ; int
    t5 = t4 * k                          ; int
    return t5                            ; int
endfunction

function Vec_show(Vec* this) : void
    t1 = *this                           ; int
    t2 = this + 4                        ; int*
    t3 = *t2                             ; int
    param str4
    param t1
    param t3
    t4 = call printf, 3                  ; int
    return
endfunction

function main() : int
    local a : Vec (8)
    local b : Vec (8)
    local c : Vec (8)
    param 4
    t1 = call area, 1                    ; int
    param 3
    param 5
    t2 = call area__1, 2                 ; int
    param 2.0
    t3 = call area__2, 1                 ; double
    param str5
    param t1
    param t2
    param t3
    t4 = call printf, 4                  ; int
    param 7
    call print, 1
    param 2.5
    call print__1, 1
    param str6
    call print__2, 1
    param 122
    call print__3, 1
    t5 = &a                              ; Vec*
    param t5
    call Vec_Vec, 1
    t6 = &b                              ; Vec*
    param t6
    param 3
    call Vec_Vec__1, 2
    t7 = &c                              ; Vec*
    param t7
    param 1
    param 2
    call Vec_Vec__2, 3
    t8 = &a                              ; Vec*
    param t8
    call Vec_show, 1
    t9 = &b                              ; Vec*
    param t9
    call Vec_show, 1
    t10 = &c                             ; Vec*
    param t10
    call Vec_show, 1
    t11 = &a                             ; Vec*
    param t11
    param 4
    call Vec_set, 2
    t12 = &a                             ; Vec*
    param t12
    call Vec_show, 1
    t13 = &a                             ; Vec*
    param t13
    param 5
    param 6
    call Vec_set__1, 3
    t14 = &a                             ; Vec*
    param t14
    call Vec_show, 1
    t15 = &a                             ; Vec*
    t16 = &c                             ; Vec*
    param t15
    param t16
    t17 = call Vec_dot, 2                ; int
    t18 = &c                             ; Vec*
    param t18
    param 10
    t19 = call Vec_dot__1, 2             ; int
    param str7
    param t17
    param t19
    t20 = call printf, 3                 ; int
    return 0                             ; int
endfunction
