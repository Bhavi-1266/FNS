; FNS three-address code
; source: test/28_floating_point.c

.data
    str0: "sum=%f diff=%f prod=%f\n"
    str1: "avg=%f\n"
    str2: "g=%f\n"
    str3: "n=%d d=%f back=%f\n"
    str4: "gt=%d le=%d eq=%d\n"
    str5: "neg=%f\n"
    str6: "mean=%f\n"

.extern
    printf

.text

function average(double a, double b) : double
    t1 = a + b                           ; double
    t2 = t1 / 2.0                        ; double
    return t2                            ; double
endfunction

function main() : int
    local x : double (8)
    local y : double (8)
    local f : float (4)
    local g : float (4)
    local n : int (4)
    local d : double (8)
    local back : float (4)
    local vals : double[4] (32)
    local acc : double (8)
    local i : int (4)
    x = 2.5                              ; double
    y = 1.25                             ; double
    t1 = x + y                           ; double
    t2 = x - y                           ; double
    t3 = x * y                           ; double
    param str0
    param t1
    param t2
    param t3
    t4 = call printf, 4                  ; int
    param x
    param y
    t5 = call average, 2                 ; double
    param str1
    param t5
    t6 = call printf, 2                  ; int
    t7 = (float) 0.5                     ; float
    f = t7                               ; float
    t8 = (double) f                      ; double
    t9 = t8 * 3.0                        ; double
    t10 = (float) t9                     ; float
    g = t10                              ; float
    t11 = (double) g                     ; double
    param str2
    param t11
    t12 = call printf, 2                 ; int
    t13 = (int) 7.75                     ; int
    n = t13                              ; int
    t14 = (double) n                     ; double
    t15 = t14 + 0.25                     ; double
    d = t15                              ; double
    t16 = (float) n                      ; float
    back = t16                           ; float
    t17 = (double) back                  ; double
    param str3
    param n
    param d
    param t17
    t18 = call printf, 4                 ; int
    t19 = x > y                          ; int
    t20 = (double) f                     ; double
    t21 = t20 <= 0.5                     ; int
    t22 = x == 2.5                       ; int
    param str4
    param t19
    param t21
    param t22
    t23 = call printf, 4                 ; int
    t24 = - x                            ; double
    param str5
    param t24
    t25 = call printf, 2                 ; int
    t26 = &vals                          ; double*
    *t26 = 1.0                           ; double
    t27 = &vals                          ; double*
    t28 = t27 + 8                        ; double*
    *t28 = 2.0                           ; double
    t29 = &vals                          ; double*
    t30 = t29 + 16                       ; double*
    *t30 = 3.0                           ; double
    t31 = &vals                          ; double*
    t32 = t31 + 24                       ; double*
    *t32 = 4.0                           ; double
    acc = 0.0                            ; double
    i = 0                                ; int
L1:
    t33 = i < 4                          ; int
    ifFalse t33 goto L3
    t34 = &vals                          ; double*
    t35 = i * 8                          ; int
    t36 = t34 + t35                      ; double*
    t37 = *t36                           ; double
    t38 = acc + t37                      ; double
    acc = t38                            ; double
L2:
    t39 = i + 1                          ; int
    i = t39                              ; int
    goto L1
L3:
    t40 = acc / 4.0                      ; double
    param str6
    param t40
    t41 = call printf, 2                 ; int
    return 0                             ; int
endfunction
