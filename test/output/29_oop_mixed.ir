; FNS three-address code
; source: test/29_oop_mixed.cpp

.data
    str0: "rect area=%d perim=%d\n"
    str1: "square area=%d perim=%d\n"
    str2: "shape%d total=%d\n"
    str3: "stack size=%d\n"
    str4: "pop=%d pop=%d\n"
    vtable_Shape: Shape_area, Shape_perimeter
    vtable_Rectangle: Rectangle_area, Rectangle_perimeter
    vtable_Square: Rectangle_area, Rectangle_perimeter

.extern
    __fns_new
    printf

.text

function Shape_area(Shape* this) : int
    return 0                             ; int
endfunction

function Shape_perimeter(Shape* this) : int
    return 0                             ; int
endfunction

function Shape_Shape(Shape* this) : void
    t1 = &vtable_Shape                   ; ptr
    *this = t1                           ; ptr
    return
endfunction

function Rectangle_Rectangle(Rectangle* this, int width, int height) : void
    param this
    call Shape_Shape, 1
    t1 = &vtable_Rectangle               ; ptr
    *this = t1                           ; ptr
    t2 = this + 4                        ; int*
    t3 = this + 8                        ; int*
    t4 = this + 4                        ; int*
    *t4 = width                          ; int
    t5 = this + 8                        ; int*
    *t5 = height                         ; int
    return
endfunction

function Rectangle_area(Rectangle* this) : int
    t1 = this + 4                        ; int*
    t2 = *t1                             ; int
    t3 = this + 8                        ; int*
    t4 = *t3                             ; int
    t5 = t2 * t4                         ; int
    return t5                            ; int
endfunction

function Rectangle_perimeter(Rectangle* this) : int
    t1 = this + 4                        ; int*
    t2 = *t1                             ; int
    t3 = this + 8                        ; int*
    t4 = *t3                             ; int
    t5 = t2 + t4                         ; int
    t6 = 2 * t5                          ; int
    return t6                            ; int
endfunction

function Square_Square(Square* this, int side) : void
    param this
    param side
    param side
    call Rectangle_Rectangle, 3
    t1 = &vtable_Square                  ; ptr
    *this = t1                           ; ptr
    return
endfunction

function describe(Shape* s) : int
    t1 = *s                              ; ptr
    t2 = *t1                             ; fn*
    param s
    t3 = call *t2, 1                     ; int
    t4 = *s                              ; ptr
    t5 = t4 + 4                          ; ptr
    t6 = *t5                             ; fn*
    param s
    t7 = call *t6, 1                     ; int
    t8 = t3 + t7                         ; int
    return t8                            ; int
endfunction

function Stack_Stack(Stack* this, int cap) : void
    t1 = this + 4                        ; int*
    param cap
    param 4
    param 4
    t2 = call __fns_new, 3               ; void*
    *t2 = cap                            ; int
    t3 = t2 + 4                          ; int*
    *this = t3                           ; int*
    t4 = this + 4                        ; int*
    *t4 = 0                              ; int
    return
endfunction

function Stack_push(Stack* this, int v) : void
    t1 = *this                           ; int*
    t2 = this + 4                        ; int*
    t3 = *t2                             ; int
    t4 = t3 * 4                          ; int
    t5 = t1 + t4                         ; int*
    *t5 = v                              ; int
    t6 = this + 4                        ; int*
    t7 = this + 4                        ; int*
    t8 = *t7                             ; int
    t9 = t8 + 1                          ; int
    *t6 = t9                             ; int
    return
endfunction

function Stack_pop(Stack* this) : int
    t1 = this + 4                        ; int*
    t2 = this + 4                        ; int*
    t3 = *t2                             ; int
    t4 = t3 - 1                          ; int
    *t1 = t4                             ; int
    t5 = *this                           ; int*
    t6 = this + 4                        ; int*
    t7 = *t6                             ; int
    t8 = t7 * 4                          ; int
    t9 = t5 + t8                         ; int*
    t10 = *t9                            ; int
    return t10                           ; int
endfunction

function Stack_size(Stack* this) : int
    t1 = this + 4                        ; int*
    t2 = *t1                             ; int
    return t2                            ; int
endfunction

function main() : int
    local r : Rectangle (12)
    local sq : Square (12)
    local shapes : Shape[2]* (8)
    local i : int (4)
    local s : Stack (8)
    local first : int (4)
    local second : int (4)
    t1 = &r                              ; Rectangle*
    param t1
    param 3
    param 4
    call Rectangle_Rectangle, 3
    t2 = &sq                             ; Square*
    param t2
    param 5
    call Square_Square, 2
    t3 = &r                              ; Rectangle*
    t4 = *t3                             ; ptr
    t5 = *t4                             ; fn*
    param t3
    t6 = call *t5, 1                     ; int
    t7 = &r                              ; Rectangle*
    t8 = *t7                             ; ptr
    t9 = t8 + 4                          ; ptr
    t10 = *t9                            ; fn*
    param t7
    t11 = call *t10, 1                   ; int
    param str0
    param t6
    param t11
    t12 = call printf, 3                 ; int
    t13 = &sq                            ; Square*
    t14 = *t13                           ; ptr
    t15 = *t14                           ; fn*
    param t13
    t16 = call *t15, 1                   ; int
    t17 = &sq                            ; Square*
    t18 = *t17                           ; ptr
    t19 = t18 + 4                        ; ptr
    t20 = *t19                           ; fn*
    param t17
    t21 = call *t20, 1                   ; int
    param str1
    param t16
    param t21
    t22 = call printf, 3                 ; int
    t23 = &shapes                        ; Shape**
    t24 = &r                             ; Rectangle*
    t25 = (Shape*) t24                   ; Shape*
    *t23 = t25                           ; Shape*
    t26 = &shapes                        ; Shape**
    t27 = t26 + 4                        ; Shape**
    t28 = &sq                            ; Square*
    t29 = (Shape*) t28                   ; Shape*
    *t27 = t29                           ; Shape*
    i = 0                                ; int
L1:
    t30 = i < 2                          ; int
    ifFalse t30 goto L3
    t31 = &shapes                        ; Shape**
    t32 = i * 4                          ; int
    t33 = t31 + t32                      ; Shape**
    t34 = *t33                           ; Shape*
    param t34
    t35 = call describe, 1               ; int
    param str2
    param i
    param t35
    t36 = call printf, 3                 ; int
L2:
    t37 = i + 1                          ; int
    i = t37                              ; int
    goto L1
L3:
    t38 = &s                             ; Stack*
    param t38
    param 8
    call Stack_Stack, 2
    t39 = &s                             ; Stack*
    param t39
    param 10
    call Stack_push, 2
    t40 = &s                             ; Stack*
    param t40
    param 20
    call Stack_push, 2
    t41 = &s                             ; Stack*
    param t41
    param 30
    call Stack_push, 2
    t42 = &s                             ; Stack*
    param t42
    t43 = call Stack_size, 1             ; int
    param str3
    param t43
    t44 = call printf, 2                 ; int
    t45 = &s                             ; Stack*
    param t45
    t46 = call Stack_pop, 1              ; int
    first = t46                          ; int
    t47 = &s                             ; Stack*
    param t47
    t48 = call Stack_pop, 1              ; int
    second = t48                         ; int
    param str4
    param first
    param second
    t49 = call printf, 3                 ; int
    t50 = &s                             ; Stack*
    param t50
    t51 = call Stack_size, 1             ; int
    param str3
    param t51
    t52 = call printf, 2                 ; int
    return 0                             ; int
endfunction
