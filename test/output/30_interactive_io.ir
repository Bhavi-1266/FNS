; FNS three-address code
; source: test/30_interactive_io.c

.data
    str0: "Enter an integer:\n"
    str1: "%d"
    str2: "square=%d cube=%d\n"
    str3: "Enter two integers:\n"
    str4: "sum=%d max=%d\n"
    str5: "Enter your name:\n"
    str6: "%s"
    str7: "Hello, %s!\n"
    str8: "Enter text ending with '#':\n"
    str9: "digits=%d\n"

.extern
    printf
    scanf
    getchar

.text

function main() : int
    local n : int (4)
    local a : int (4)
    local b : int (4)
    local name : char[32] (32)
    local digits : int (4)
    local ch : int (4)
    param str0
    t1 = call printf, 1                  ; int
    t2 = &n                              ; int*
    param str1
    param t2
    t3 = call scanf, 2                   ; int
    t4 = n * n                           ; int
    t5 = n * n                           ; int
    t6 = t5 * n                          ; int
    param str2
    param t4
    param t6
    t7 = call printf, 3                  ; int
    param str3
    t8 = call printf, 1                  ; int
    t9 = &a                              ; int*
    param str1
    param t9
    t10 = call scanf, 2                  ; int
    t11 = &b                             ; int*
    param str1
    param t11
    t12 = call scanf, 2                  ; int
    t13 = a + b                          ; int
    t15 = a > b                          ; int
    ifFalse t15 goto L1
    t14 = a                              ; int
    goto L2
L1:
    t14 = b                              ; int
L2:
    param str4
    param t13
    param t14
    t16 = call printf, 3                 ; int
    param str5
    t17 = call printf, 1                 ; int
    t18 = &name                          ; char*
    param str6
    param t18
    t19 = call scanf, 2                  ; int
    t20 = &name                          ; char*
    param str7
    param t20
    t21 = call printf, 2                 ; int
    digits = 0                           ; int
    param str8
    t22 = call printf, 1                 ; int
L3:
    ifFalse 1 goto L4
    t23 = call getchar, 0                ; int
    ch = t23                             ; int
    t24 = (int) 35                       ; int
    t25 = ch == t24                      ; int
    ifFalse t25 goto L5
    goto L4
L5:
    t27 = (int) 48                       ; int
    t28 = ch >= t27                      ; int
    ifFalse t28 goto L7
    t29 = (int) 57                       ; int
    t30 = ch <= t29                      ; int
    ifFalse t30 goto L7
    t26 = 1                              ; int
    goto L8
L7:
    t26 = 0                              ; int
L8:
    ifFalse t26 goto L6
    t31 = digits + 1                     ; int
    digits = t31                         ; int
L6:
    goto L3
L4:
    param str9
    param digits
    t32 = call printf, 2                 ; int
    return 0                             ; int
endfunction
