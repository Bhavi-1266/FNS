function Shape_area(Shape* this) : double
    t1 = (double) 0                      ; double
    return t1                            ; double
endfunction

function Shape_Shape(Shape* this) : void
    t1 = &vtable_Shape                   ; ptr
    *this = t1                           ; ptr
    return
endfunction

function Sq_Sq(Sq* this, double v) : void
    param this
    call Shape_Shape, 1
    t1 = &vtable_Sq                      ; ptr
    *this = t1                           ; ptr
    t2 = this + 4                        ; double*
    *t2 = v                              ; double
    return
endfunction

function Sq_area(Sq* this) : double
    t1 = this + 4                        ; double*
    t2 = *t1                             ; double
    t3 = this + 4                        ; double*
    t4 = *t3                             ; double
    t5 = t2 * t4                         ; double
    return t5                            ; double
endfunction

