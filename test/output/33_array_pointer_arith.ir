function row_sum(int[4]* rows, int n) : int
    local s : int (4)
    local r : int[4]* (4)
    local j : int (4)
    s = 0                                ; int
    r = rows                             ; int[4]*
L1:
    t1 = n * 16                          ; int
    t2 = rows + t1                       ; int*
    t3 = r < t2                          ; int
    ifFalse t3 goto L3
    j = 0                                ; int
L4:
    t4 = j < 4                           ; int
    ifFalse t4 goto L6
    t5 = j * 4                           ; int
    t6 = r + t5                          ; int*
    t7 = *t6                             ; int
    t8 = s + t7                          ; int
    s = t8                               ; int
L5:
    t9 = j + 1                           ; int
    j = t9                               ; int
    goto L4
L6:
L2:
    t10 = r + 16                         ; int[4]*
    r = t10                              ; int[4]*
    goto L1
L3:
    return s                             ; int
endfunction

