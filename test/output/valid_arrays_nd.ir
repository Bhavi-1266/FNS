function sumptr(int* p, int n) : int
    local s : int (4)
    local i : int (4)
    s = 0                                ; int
    i = 0                                ; int
L1:
    t1 = i < n                           ; int
    ifFalse t1 goto L3
    t2 = i * 4                           ; int
    t3 = p + t2                          ; int*
    t4 = *t3                             ; int
    t5 = s + t4                          ; int
    s = t5                               ; int
L2:
    t6 = i + 1                           ; int
    i = t6                               ; int
    goto L1
L3:
    return s                             ; int
endfunction

