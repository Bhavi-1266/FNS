    p = t67                              ; char*
    t68 = p + 1                          ; char*
    p = t68                              ; char*
    t69 = p + 1                          ; char*
    p = t69                              ; char*
    t70 = p - 1                          ; char*
    p = t70                              ; char*
    t71 = &grid                          ; int[3]*
    t72 = (int[3]*) t71                  ; int[3]*
    param t72
    t73 = call sum2d, 1                  ; int
    t74 = &grid                          ; int[3]*
    t75 = t74 + 12                       ; int*
    t76 = (int*) t75                     ; int*
    param t76
    param 3
    t77 = call sum1d, 2                  ; int
    t78 = t73 + t77                      ; int
    t79 = &names                         ; char[8]*
    t80 = t79 + 8                        ; char*
    t81 = t80 + 1                        ; char*
    t82 = *t81                           ; char
    t83 = (int) t82                      ; int
    t84 = t78 + t83                      ; int
    t85 = (unsigned int) t84             ; unsigned int
    t86 = (unsigned int) uc              ; unsigned int
    t87 = t85 + t86                      ; unsigned int
    t88 = (int) u                        ; int
    t89 = (unsigned int) t88             ; unsigned int
    t90 = t87 + t89                      ; unsigned int
    t91 = (int) l                        ; int
    t92 = (unsigned int) t91             ; unsigned int
    t93 = t90 + t92                      ; unsigned int
    t94 = (unsigned int) sz              ; unsigned int
    t95 = t93 + t94                      ; unsigned int
    t96 = (int) t95                      ; int
    r = t96                              ; int
    t97 = &fpa                           ; fn**
    t98 = t97 + 4                        ; fn**
    t99 = *t98                           ; fn*
    param 5
    param 3
    t100 = call *t99, 2                  ; int
    t101 = &fpa                          ; fn**
    t102 = *t101                         ; fn*
    param 1
    param 1
    t103 = call *t102, 2                 ; int
    t104 = t100 + t103                   ; int
    t105 = &ops                          ; fn**
    t106 = *t105                         ; fn*
    param 2
    param 1
    t107 = call *t106, 2                 ; int
    t108 = t104 + t107                   ; int
    param 1
    param 2
    t109 = call *one, 2                  ; int
    t110 = t108 + t109                   ; int
    t111 = *pcs                          ; int
    t112 = t110 + t111                   ; int
    t113 = *cp                           ; int
    t114 = t112 + t113                   ; int
    t115 = &loc                          ; struct Local*
    t116 = *t115                         ; int
    t117 = t114 + t116                   ; int
    t118 = &loc                          ; struct Local*
    t119 = t118 + 4                      ; int*
    t120 = *t119                         ; int
    t121 = t117 + t120                   ; int
    t122 = (int) m                       ; int
    t123 = t121 + t122                   ; int
    t124 = t123 + c                      ; int
    t125 = *p                            ; char
    t126 = (int) t125                    ; int
    t127 = t124 + t126                   ; int
    t128 = r + t127                      ; int
    r = t128                             ; int
    t129 = sp == tp                      ; int
    ifFalse t129 goto L1
    t130 = r + 1                         ; int
    r = t130                             ; int
L1:
L1_:
    t131 = r + 1                         ; int
    r = t131                             ; int
    t132 = r < 0                         ; int
    ifFalse t132 goto L2
    goto L1_
L2:
    t133 = &main_ss                      ; struct S*
    *t133 = r                            ; int
    t134 = &main_ss                      ; struct S*
    t135 = *t134                         ; int
    return t135                          ; int
endfunction
