    *t24 = 0                             ; char
    t25 = t20 + 5                        ; char*
    *t25 = 0                             ; char
    t26 = t20 + 6                        ; char*
    *t26 = 0                             ; char
    t27 = t20 + 7                        ; char*
    *t27 = 0                             ; char
    *t12 = 0                             ; char
    t28 = t12 + 1                        ; char*
    *t28 = 0                             ; char
    t29 = t12 + 2                        ; char*
    *t29 = 0                             ; char
    t30 = t12 + 3                        ; char*
    *t30 = 0                             ; char
    t31 = t12 + 4                        ; char*
    *t31 = 0                             ; char
    t32 = t12 + 5                        ; char*
    *t32 = 0                             ; char
    t33 = t12 + 6                        ; char*
    *t33 = 0                             ; char
    t34 = t12 + 7                        ; char*
    *t34 = 0                             ; char
    copy t12, str0, 3                    ; char[]
    t35 = t12 + 8                        ; char*
    *t35 = 0                             ; char
    t36 = t35 + 1                        ; char*
    *t36 = 0                             ; char
    t37 = t35 + 2                        ; char*
    *t37 = 0                             ; char
    t38 = t35 + 3                        ; char*
    *t38 = 0                             ; char
    t39 = t35 + 4                        ; char*
    *t39 = 0                             ; char
    t40 = t35 + 5                        ; char*
    *t40 = 0                             ; char
    t41 = t35 + 6                        ; char*
    *t41 = 0                             ; char
    t42 = t35 + 7                        ; char*
    *t42 = 0                             ; char
    copy t35, str1, 3                    ; char[]
    v = 300                              ; int
    d = 2.5                              ; double
    vp = 0                               ; void*
    t43 = (unsigned char) v              ; unsigned char
    uc = t43                             ; unsigned char
    t44 = (unsigned int) d               ; unsigned int
    u = t44                              ; unsigned int
    t45 = (long) d                       ; long
    l = t45                              ; long
    t46 = 4 + 4                          ; int
