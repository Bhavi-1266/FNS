; FNS three-address code
; source: test/ir_phase/valid_fixed_constructs.c

.data
    str0: "ab"
    str1: "cd"
    str2: "abc"
    global main_ss : struct S (4)

.text

function add(int a, int b) : int
    t1 = a + b                           ; int
    return t1                            ; int
endfunction

function sub(int a, int b) : int
    t1 = a - b                           ; int
    return t1                            ; int
endfunction

function sum2d(int[3]* m) : int
    t1 = m + 12                          ; int*
    t2 = t1 + 8                          ; int*
    t3 = *t2                             ; int
    return t3                            ; int
endfunction

function sum1d(int* a, int n) : int
    t1 = n - 1                           ; int
    t2 = t1 * 4                          ; int
    t3 = a + t2                          ; int*
    t4 = *t3                             ; int
    return t4                            ; int
endfunction

function main() : int
    local grid : int[2][3] (24)
    local names : char[2][8] (16)
    local v : int (4)
    local d : double (8)
    local vp : void* (4)
    local uc : unsigned char (1)
    local u : unsigned int (4)
    local l : long (4)
    local sz : int (4)
    local sp : struct S* (4)
    local tp : struct S* (4)
    local fpa : fn[2]* (8)
    local ops : fn[2]* (8)
    local one : fn* (4)
    local cs : struct S (4)
    local pcs : struct S* (4)
    local cp : int* (4)
    local loc : struct Local (8)
    local m : enum Mode (4)
    local c : int (4)
    local buf : char[4] (4)
    local p : char* (4)
    local r : int (4)
    t1 = &grid                           ; int[3]*
    *t1 = 0                              ; int
    t2 = t1 + 4                          ; int*
    *t2 = 0                              ; int
    t3 = t1 + 8                          ; int*
    *t3 = 0                              ; int
    t4 = t1 + 12                         ; int*
    *t4 = 0                              ; int
