    t52 = t50 + 4                        ; fn**
    *t52 = sub                           ; fn*
    t53 = &ops                           ; fn**
    *t53 = 0                             ; fn*
    t54 = t53 + 4                        ; fn**
    *t54 = 0                             ; fn*
    *t53 = sub                           ; fn*
    t55 = t53 + 4                        ; fn**
    *t55 = add                           ; fn*
    one = add                            ; fn*
    t56 = &cs                            ; struct S*
    *t56 = 0                             ; int
    *t56 = 7                             ; int
    t57 = &cs                            ; struct S*
    pcs = t57                            ; struct S*
    t58 = &v                             ; int*
    cp = t58                             ; int*
    t59 = &loc                           ; struct Local*
    *t59 = 1                             ; int
    t60 = &loc                           ; struct Local*
    t61 = t60 + 4                        ; int*
    *t61 = 2                             ; int
    m = 5                                ; enum Mode
