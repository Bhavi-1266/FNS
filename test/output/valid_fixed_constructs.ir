    t12 = &names                         ; char[8]*
    *t12 = 0                             ; char
    t13 = t12 + 1                        ; char*
    *t13 = 0                             ; char
    t14 = t12 + 2                        ; char*
    *t14 = 0                             ; char
    t15 = t12 + 3                        ; char*
    *t15 = 0                             ; char
