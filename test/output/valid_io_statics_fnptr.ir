; FNS three-address code
; source: test/ir_phase/valid_io_statics_fnptr.c

.data
    str0: "x=%d f=%f c=%c s=%hd d=%f str=%s\n"
    str1: "lit"
    str2: "plain\n"
    str3: "%s"
    str4: "%d %f %c"
    str5: "%d"
    str6: "a.txt"
    str7: "w"
    str8: "%d\n"
    str9: "r"
    global counter_n : int (4) = 0
    global counter_m : int (4)
    global counter2_n : int (4) = 10
    global rec_depth : int (4) = 0

.extern
    printf
    scanf
    fopen
    fprintf
    fclose
    fgets
    fscanf
    malloc
    free
    calloc
    realloc
    exit

.text

function noop() : void
    return
endfunction

function noret(int a) : int
    ifFalse a goto L1
    return 1                             ; int
L1:
    return
endfunction

function half(double x) : double
    t1 = (double) 2                      ; double
    t2 = x / t1                          ; double
    return t2                            ; double
endfunction

function counter() : int
    t1 = counter_n + 1                   ; int
    counter_n = t1                       ; int
    t2 = t1 + counter_m                  ; int
    return t2                            ; int
endfunction

function counter2() : int
    t1 = counter2_n                      ; int
    t2 = counter2_n - 1                  ; int
    counter2_n = t2                      ; int
    return t1                            ; int
endfunction

function rec(int n) : int
    t1 = rec_depth + 1                   ; int
    rec_depth = t1                       ; int
    t2 = n <= 0                          ; int
    ifFalse t2 goto L2
    return rec_depth                     ; int
L2:
    t3 = n - 1                           ; int
    param t3
    t4 = call rec, 1                     ; int
    return t4                            ; int
endfunction

function vsum(int n, ...) : int
    return n                             ; int
endfunction

function apply(fn* f, int a, int b) : int
    param a
    param b
    t1 = call *f, 2                      ; int
    return t1                            ; int
endfunction

function add(int a, int b) : int
    t1 = a + b                           ; int
    return t1                            ; int
endfunction

function sub(int a, int b) : int
    t1 = a - b                           ; int
    return t1                            ; int
endfunction

function main(int argc, char** argv) : int
    local x : int (4)
    local fl : float (4)
    local ch : char (1)
    local sh : short (2)
    local d : double (8)
    local ret : int (4)
    local fname : char* (4)
    local av : char** (4)
    local fp : void* (4)
    local fp2 : void* (4)
    local buf : char[32] (32)
    local n : int (4)
    local fp3 : fn* (4)
    local r : int (4)
    local c : int (4)
    local recp : fn* (4)
    local mp : int* (4)
    local mc : int* (4)
    fl = 1.5f                            ; float
    ch = 113                             ; char
    t1 = (short) 2                       ; short
    sh = t1                              ; short
    d = 3.0                              ; double
    t2 = (double) fl                     ; double
    t3 = (int) ch                        ; int
    t4 = (int) sh                        ; int
    param str0
    param x
    param t2
    param t3
    param t4
    param d
    param str1
    t5 = call printf, 7                  ; int
    param str2
    t6 = call printf, 1                  ; int
    t7 = *argv                           ; char*
    param str3
    param t7
    t8 = call printf, 2                  ; int
    t9 = &x                              ; int*
    t10 = &fl                            ; float*
    t11 = &ch                            ; char*
    param str4
    param t9
    param t10
    param t11
    t12 = call scanf, 4                  ; int
    t13 = &x                             ; int*
    param str5
    param t13
    t14 = call scanf, 2                  ; int
    ret = t14                            ; int
    t15 = argc > 1                       ; int
    ifFalse t15 goto L3
    t16 = argv + 4                       ; char**
    t17 = *t16                           ; char*
    t18 = *t17                           ; char
    t19 = (int) t18                      ; int
    t20 = (int) 48                       ; int
    t21 = t19 - t20                      ; int
    x = t21                              ; int
L3:
    t22 = argc - 1                       ; int
    t23 = t22 * 4                        ; int
    t24 = argv + t23                     ; char**
    t25 = *t24                           ; char*
    fname = t25                          ; char*
    t26 = 1 * 4                          ; int
    t27 = argv + t26                     ; char**
    av = t27                             ; char**
    param str6
    param str7
    t28 = call fopen, 2                  ; void*
    fp = t28                             ; void*
    param fp
    param str8
    param x
    t29 = call fprintf, 3                ; int
    param fp
    t30 = call fclose, 1                 ; int
    param fname
    param str9
    t31 = call fopen, 2                  ; void*
    fp2 = t31                            ; void*
    t32 = &buf                           ; char*
    t33 = (char*) t32                    ; char*
    param t33
    param 32
    param fp2
    t34 = call fgets, 3                  ; char*
    t35 = &x                             ; int*
    param fp2
    param str5
    param t35
    t36 = call fscanf, 3                 ; int
    param fp2
    t37 = call fclose, 1                 ; int
    param 0
    t38 = call vsum, 1                   ; int
    param 1
    param 2
    t39 = call vsum, 2                   ; int
    t40 = t38 + t39                      ; int
    t41 = (int) 99                       ; int
    t42 = (int) sh                       ; int
    t43 = (double) fl                    ; double
    param 3
    param 1.5
    param t41
    param t42
    param t43
    t44 = call vsum, 5                   ; int
    t45 = t40 + t44                      ; int
    n = t45                              ; int
    call noop, 0
    param 2.0
    t46 = call half, 1                   ; double
    fp3 = add                            ; fn*
    fp3 = sub                            ; fn*
    param add
    param 1
    param 2
    t47 = call apply, 3                  ; int
    param fp3
    param 3
    param 4
    t48 = call apply, 3                  ; int
    t49 = t47 + t48                      ; int
    param 1
    param 1
    t50 = call *fp3, 2                   ; int
    t51 = t49 + t50                      ; int
    param 2
    param 2
    t52 = call *fp3, 2                   ; int
    t53 = t51 + t52                      ; int
    r = t53                              ; int
    t54 = call counter, 0                ; int
    t55 = call counter, 0                ; int
    t56 = t54 + t55                      ; int
    t57 = call counter2, 0               ; int
    t58 = t56 + t57                      ; int
    param 3
    t59 = call rec, 1                    ; int
    t60 = t58 + t59                      ; int
    param 1
    t61 = call noret, 1                  ; int
    t62 = t60 + t61                      ; int
    param 4.0
    t63 = call half, 1                   ; double
    t64 = (int) t63                      ; int
    t65 = t62 + t64                      ; int
    c = t65                              ; int
    recp = rec                           ; fn*
    param 1
    t66 = call *recp, 1                  ; int
    t67 = c + t66                        ; int
    c = t67                              ; int
    t68 = 4 * 4                          ; int
    t69 = (unsigned int) t68             ; unsigned int
    param t69
    t70 = call malloc, 1                 ; void*
    t71 = (int*) t70                     ; int*
    mp = t71                             ; int*
    *mp = 1                              ; int
    param mp
    call free, 1
    t72 = (unsigned int) 4               ; unsigned int
    t73 = (unsigned int) 4               ; unsigned int
    param t72
    param t73
    t74 = call calloc, 2                 ; void*
    t75 = (int*) t74                     ; int*
    mc = t75                             ; int*
    t76 = (unsigned int) 8               ; unsigned int
    param mc
    param t76
    t77 = call realloc, 2                ; void*
    t78 = (int*) t77                     ; int*
    mc = t78                             ; int*
    param mc
    call free, 1
    param 0
    call exit, 1
    t79 = x + ret                        ; int
    t80 = t79 + n                        ; int
    t81 = t80 + r                        ; int
    t82 = t81 + c                        ; int
    return t82                           ; int
endfunction
