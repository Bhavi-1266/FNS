    return t1                            ; int
endfunction

function lambda_4(int a, int* cap_y, int cap_x) : int
    t1 = cap_x + a                       ; int
    *cap_y = t1                          ; int
    t2 = *cap_y                          ; int
    return t2                            ; int
endfunction

function lambda_5(int a) : int
    return a                             ; int
endfunction

function lambda_6(int a) : int
    t1 = a + g                           ; int
