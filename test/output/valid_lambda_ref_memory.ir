function __global_init() : void
    t1 = g * 2                           ; int
    gi = t1                              ; int
    return
endfunction

function apply(fn* f, int v) : int
    param v
    t1 = call *f, 1                      ; int
    return t1                            ; int
endfunction

function swap(int& a, int& b) : void
    local t : int (4)
    t1 = *a                              ; int
    t = t1                               ; int
    t2 = *b                              ; int
    *a = t2                              ; int
    *b = t                               ; int
    return
endfunction

function pick(int& a, int& b, int which) : int&
    ifFalse which goto L1
    return a                             ; int*
L1:
    return b                             ; int*
endfunction

function cref(int& x) : int&
    return x                             ; int*
endfunction

function R_R(struct R* this, int& x) : void
    *this = x                            ; int*
