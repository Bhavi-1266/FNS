    *t1 = 0                              ; int
    return
endfunction

function R_get(struct R* this) : int
    t1 = *this                           ; int*
    t2 = *t1                             ; int
    return t2                            ; int
endfunction

function lambda_1(int a) : int
    t1 = a * 2                           ; int
