; FNS three-address code
; source: test/ir_phase/valid_oop_access_dispatch.cpp

.data
    global Base_count : int (4)
    vtable_Base: Base_get, Base_set
    vtable_Mid: Mid_get, Base_set
    vtable_Leaf: Mid_get, Leaf_set

.extern
    __fns_new
    free

.text

function Base_Base(Base* this) : void
    t1 = &vtable_Base                    ; ptr
    *this = t1                           ; ptr
    t2 = this + 4                        ; int*
    *t2 = 1                              ; int
    t3 = this + 8                        ; int*
    *t3 = 2                              ; int
    t4 = this + 12                       ; int*
    *t4 = 3                              ; int
    t5 = Base_count + 1                  ; int
    Base_count = t5                      ; int
    return
endfunction

function Base_get(Base* this) : int
    t1 = this + 4                        ; int*
    t2 = *t1                             ; int
    t3 = this + 8                        ; int*
    t4 = *t3                             ; int
    t5 = t2 + t4                         ; int
    return t5                            ; int
endfunction

function Base_set(Base* this, int v) : void
    t1 = this + 4                        ; int*
    *t1 = v                              ; int
    return
endfunction

function Base_direct(Base* this) : int
    t1 = this + 8                        ; int*
    t2 = *t1                             ; int
    return t2                            ; int
endfunction

function Base_total() : int
    return Base_count                    ; int
endfunction

function Base_compare(Base* this, int o) : int
    t1 = this + 8                        ; int*
    t2 = *t1                             ; int
    t3 = o == t2                         ; int
    return t3                            ; int
endfunction

function Base__dtor(Base* this) : void
    t1 = &vtable_Base                    ; ptr
    *this = t1                           ; ptr
    t2 = this + 12                       ; int*
    *t2 = 0                              ; int
    return
endfunction

function Mid_Mid(Mid* this) : void
    param this
    call Base_Base, 1
    t1 = &vtable_Mid                     ; ptr
    *this = t1                           ; ptr
    t2 = this + 16                       ; int*
    *t2 = 5                              ; int
    return
endfunction

function Mid_get(Mid* this) : int
    t1 = this + 4                        ; int*
    t2 = *t1                             ; int
    t3 = this + 16                       ; int*
    t4 = *t3                             ; int
    t5 = t2 + t4                         ; int
    return t5                            ; int
endfunction

function Mid_callbase(Mid* this) : int
    param this
    t1 = call Base_get, 1                ; int
    param this
    t2 = call Base_direct, 1             ; int
    t3 = t1 + t2                         ; int
    return t3                            ; int
endfunction

function Mid_smid() : int
    t1 = call Base_total, 0              ; int
    return t1                            ; int
endfunction

function Mid__dtor(Mid* this) : void
    t1 = &vtable_Mid                     ; ptr
    *this = t1                           ; ptr
    param this
    call Base__dtor, 1
    return
endfunction

function Leaf_Leaf(Leaf* this) : void
    param this
    call Mid_Mid, 1
    t1 = &vtable_Leaf                    ; ptr
    *this = t1                           ; ptr
    t2 = this + 20                       ; int*
    *t2 = 0                              ; int
    return
endfunction

function Leaf_set(Leaf* this, int v) : void
    t1 = this + 16                       ; int*
    *t1 = v                              ; int
    t2 = this + 20                       ; int*
    t3 = this + 4                        ; int*
    t4 = *t3                             ; int
    *t2 = t4                             ; int
    return
endfunction

function Leaf__dtor(Leaf* this) : void
    t1 = &vtable_Leaf                    ; ptr
    *this = t1                           ; ptr
    param this
    call Mid__dtor, 1
    return
endfunction

function Holder_Holder(Holder* this) : void
    param this
    call Mid_Mid, 1
    t1 = this + 20                       ; Leaf*
    param t1
    call Leaf_Leaf, 1
    t2 = this + 44                       ; int*
    *t2 = 1                              ; int
    return
endfunction

function Holder__dtor(Holder* this) : void
    t1 = this + 20                       ; Leaf*
    param t1
    call Leaf__dtor, 1
    param this
    call Mid__dtor, 1
    return
endfunction

function Pt_Pt(struct Pt* this, int a, int b) : void
    *this = a                            ; int
    t1 = this + 4                        ; int*
    *t1 = b                              ; int
    return
endfunction

function Pt_sum(struct Pt* this) : int
    t1 = *this                           ; int
    t2 = this + 4                        ; int*
    t3 = *t2                             ; int
    t4 = t1 + t3                         ; int
    return t4                            ; int
endfunction

function Noctor_f(Noctor* this) : int
    t1 = *this                           ; int
    return t1                            ; int
endfunction

function use(Base* b) : int
    t1 = *b                              ; ptr
    t2 = *t1                             ; fn*
    param b
    t3 = call *t2, 1                     ; int
    return t3                            ; int
endfunction

function useref(Base& b) : int
    t1 = *b                              ; ptr
    t2 = t1 + 4                          ; ptr
    t3 = *t2                             ; fn*
    param b
    param 9
    call *t3, 2
    t4 = *b                              ; ptr
    t5 = *t4                             ; fn*
    param b
    t6 = call *t5, 1                     ; int
    return t6                            ; int
endfunction

